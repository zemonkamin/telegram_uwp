<Page
    x:Class="Telegram.GroupProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ProfilePageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="ProfilePanelBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="ProfilePrimaryTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ProfileSecondaryTextBrush" Color="#FFB8B8B8" />
                    <SolidColorBrush x:Key="ProfileHeaderTabBrush" Color="#FFE9E9E9" />
                    <SolidColorBrush x:Key="ProfileHeaderPrimaryTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ProfileHeaderSecondaryTextBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="ProfileAvatarFallbackBrush" Color="#FF584DFF" />
                    <SolidColorBrush x:Key="ProfileHeaderBackgroundBrush" Color="#FF282828" />
                    <SolidColorBrush x:Key="ProfileDividerBrush" Color="#FF202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ProfilePageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ProfilePanelBackgroundBrush" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="ProfilePrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="ProfileSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="ProfileHeaderTabBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="ProfileHeaderPrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="ProfileHeaderSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="ProfileAvatarFallbackBrush" Color="#FF584DFF" />
                    <SolidColorBrush x:Key="ProfileHeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="ProfileDividerBrush" Color="#FFE5E5E5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ProfilePageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ProfileScroll" Grid.Row="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Grid x:Name="HeaderHost" Height="142" Background="{ThemeResource ProfileHeaderBackgroundBrush}" SizeChanged="HeaderHost_SizeChanged">
                    <Grid x:Name="ExpandedHeaderMedia" Background="{ThemeResource ProfileHeaderBackgroundBrush}" Opacity="0">
                        <Image x:Name="HeaderPhoto" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Stretch="UniformToFill" />
                        <Grid x:Name="HeaderFallback" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{ThemeResource ProfileAvatarFallbackBrush}">
                            <TextBlock x:Name="HeaderInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="96" FontWeight="SemiLight" Foreground="White" Text="?" />
                        </Grid>
	                        <Grid
	                            x:Name="HeaderGlassGradient"
	                            Height="190"
	                            VerticalAlignment="Bottom"
	                            Background="Transparent"
	                            IsHitTestVisible="False"
	                            Loaded="HeaderGlassGradient_Loaded" />

	                        <Rectangle
	                            x:Name="HeaderDarkGradient"
	                            Height="116"
	                            VerticalAlignment="Bottom"
	                            IsHitTestVisible="False"
	                            Visibility="Collapsed">
	                            <Rectangle.Fill>
	                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
	                                    <GradientStop Offset="0" Color="#00000000" />
	                                    <GradientStop Offset="0.72" Color="#77000000" />
	                                    <GradientStop Offset="1" Color="#BB000000" />
	                                </LinearGradientBrush>
	                            </Rectangle.Fill>
	                        </Rectangle>

	                        <Grid x:Name="HeaderPhotoIndicators" Height="4" Margin="10,10,10,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
	                    </Grid>
                    <Grid x:Name="CompactAvatar" Width="62" Height="62" Margin="20,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse Fill="{ThemeResource ProfileAvatarFallbackBrush}" />
                        <Ellipse x:Name="CompactAvatarImage" Opacity="0">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="CompactAvatarBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="CompactInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="White" Text="?" />
                    </Grid>
                    <StackPanel x:Name="HeaderTextPanel" Margin="96,32,12,0" VerticalAlignment="Top">
                        <TextBlock x:Name="ProfileTitle" FontSize="25" FontWeight="SemiLight" Foreground="{ThemeResource ProfileHeaderPrimaryTextBrush}" MaxLines="1" Text="Group" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProfileSubtitle" Margin="0,2,0,0" FontSize="16" Foreground="{ThemeResource ProfileHeaderSecondaryTextBrush}" MaxLines="1" Text="" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Height="46" VerticalAlignment="Bottom" Orientation="Horizontal" Padding="20,0,18,0">
                        <TextBlock x:Name="MembersTab" Text="Members" FontSize="24" FontWeight="Light" Foreground="{ThemeResource ProfileHeaderPrimaryTextBrush}" Margin="0,0,24,8" VerticalAlignment="Bottom" Tapped="MembersTab_Tapped" />
                        <TextBlock x:Name="MediaTab" Text="Media" FontSize="24" FontWeight="Light" Foreground="{ThemeResource ProfileHeaderTabBrush}" Opacity="0.68" Margin="0,0,24,8" VerticalAlignment="Bottom" Tapped="MediaTab_Tapped" />
                        <TextBlock x:Name="FilesTab" Text="Files" FontSize="24" FontWeight="Light" Foreground="{ThemeResource ProfileHeaderTabBrush}" Opacity="0.68" Margin="0,0,24,8" VerticalAlignment="Bottom" Tapped="FilesTab_Tapped" />
                        <TextBlock x:Name="AudioTab" Text="Audio" FontSize="24" FontWeight="Light" Foreground="{ThemeResource ProfileHeaderTabBrush}" Opacity="0.68" Margin="0,0,0,8" VerticalAlignment="Bottom" Tapped="AudioTab_Tapped" />
                    </StackPanel>
                    <Rectangle x:Name="HeaderGestureArea" Margin="0,0,0,46" Fill="Transparent" ManipulationMode="TranslateY" PointerPressed="HeaderGestureArea_PointerPressed" PointerMoved="HeaderGestureArea_PointerMoved" PointerReleased="HeaderGestureArea_PointerReleased" PointerCanceled="HeaderGestureArea_PointerReleased" PointerCaptureLost="HeaderGestureArea_PointerReleased" />
                </Grid>
                <Grid Padding="20,14,12,16">
                    <StackPanel>
                        <ListView x:Name="MembersList" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="MembersList_ItemClick" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="58" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse Fill="{ThemeResource ProfileAvatarFallbackBrush}" />
                                            <Ellipse Opacity="{Binding AvatarImageOpacity}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiLight" Foreground="{ThemeResource ProfilePrimaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleText}" FontSize="12" Foreground="{ThemeResource ProfileSecondaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MemberRole}" FontSize="12" Foreground="{ThemeResource ProfileSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ListView x:Name="ContentList" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="ContentList_ItemClick" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="58" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="{ThemeResource ProfileDividerBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding PreviewSource}" Stretch="UniformToFill" Visibility="{Binding PreviewVisibility}" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding AudioPreviewVisibility}">
                                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{ThemeResource ProfilePrimaryTextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding PreviewLabel}" Margin="0,1,0,0" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource ProfileSecondaryTextBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{ThemeResource ProfilePrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiLight" Foreground="{ThemeResource ProfilePrimaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource ProfileSecondaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <GridView x:Name="MediaGrid" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" Visibility="Collapsed">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="104" ItemHeight="104" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,3,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="104" Height="104" Background="{ThemeResource ProfileDividerBrush}">
                                        <Image Source="{Binding PreviewSource}" Stretch="UniformToFill" Visibility="{Binding PreviewVisibility}" />
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{ThemeResource ProfilePrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Background="#AA000000" Width="26" Height="26" Visibility="{Binding VideoBadgeVisibility}">
                                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Button x:Name="LoadMoreContentButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" Background="{ThemeResource ProfilePanelBackgroundBrush}" BorderThickness="0" Click="LoadMoreContentButton_Click" Content="Load more" Foreground="{ThemeResource ProfilePrimaryTextBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="EmptyContentText" Margin="0,10,0,0" FontSize="14" Foreground="{ThemeResource ProfileSecondaryTextBrush}" Text="" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar x:Name="TopLoadingBar" Grid.Row="0" Height="3" VerticalAlignment="Top" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" IsIndeterminate="False" Visibility="Collapsed" />
        <CommandBar
            Grid.Row="1"
            Background="{ThemeResource ProfilePanelBackgroundBrush}"
            ClosedDisplayMode="Compact"
            Foreground="{ThemeResource ProfilePrimaryTextBrush}">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="ChatButton_Click"
                    Label="Chat">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BD;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <Grid x:Name="MediaOverlay" Grid.RowSpan="2" Background="#D9000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Grid x:Name="MediaOverlayBackground" Background="Transparent" Tapped="MediaOverlayBackground_Tapped" />
            <Button x:Name="CloseMediaOverlayButton" Canvas.ZIndex="20" Width="44" Height="44" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000" BorderThickness="0" Click="CloseMediaOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button"><Grid><Ellipse Width="44" Height="44" Fill="{TemplateBinding Background}" /><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" />
            </Button>
            <TextBlock x:Name="MediaOverlayCounter" Canvas.ZIndex="20" Margin="0,27,18,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" Foreground="#CCCCCC" />
            <Button x:Name="GoToMediaMessageButton" Canvas.ZIndex="20" Width="44" Height="44" Margin="0,0,66,14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC000000" BorderThickness="0" Click="GoToMediaMessageButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button"><Grid><Ellipse Width="44" Height="44" Fill="{TemplateBinding Background}" /><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" />
            </Button>
            <Button x:Name="DownloadMediaOverlayButton" Canvas.ZIndex="20" Width="44" Height="44" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC000000" BorderThickness="0" Click="DownloadMediaOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button"><Grid><Ellipse Width="44" Height="44" Fill="{TemplateBinding Background}" /><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" />
            </Button>
            <FlipView x:Name="MediaOverlayFlipView" Margin="0,64,0,64" SelectionChanged="MediaOverlayFlipView_SelectionChanged">
                <FlipView.ItemTemplate>
                    <DataTemplate>
                        <ScrollViewer ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
                            <Grid><Image Source="{Binding}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        </ScrollViewer>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
            <StackPanel x:Name="MediaOverlayIndicatorPanel" Canvas.ZIndex="20" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />
        </Grid>
    </Grid>
</Page>
