<Page
    x:Class="Telegram.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Telegram"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1F2937" Padding="22,16">
            <TextBlock Text="Sign in to Telegram" Foreground="White" FontSize="24" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Width="460" Padding="20">
                <TextBlock Text="Enter your phone number in international format. Telegram will send a code by SMS or to an already open Telegram app."
                           TextWrapping="Wrap" FontSize="16" />

                <TextBlock Text="Phone number" FontWeight="SemiBold" Margin="0,18,0,4" />
                <TextBox x:Name="PhoneNumberBox" PlaceholderText="+79991234567" />

                <Button x:Name="SendCodeButton"
                        Content="Get code"
                        MinWidth="160"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Click="SendCodeButton_Click" />

                <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="Telegram code" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="CodeBox" PlaceholderText="12345" />
                    <Button x:Name="SignInButton"
                            Content="Sign in"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="SignInButton_Click" />
                </StackPanel>

                <Button x:Name="ProxyToggleButton" Content="Proxy settings" Click="ProxyToggleButton_Click"
                        HorizontalAlignment="Stretch" Margin="0,22,0,0" Background="#222222" Foreground="#DDDDDD"/>

                <Border x:Name="ProxyPanel" Visibility="Collapsed" Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Proxy" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <RadioButton x:Name="ProxyModeNone" Content="System proxy / VPN" GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeMtproto" Content="MTProto" GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeHttp" Content="HTTP" GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeSocks" Content="SOCKS5" GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>

                        <TextBox x:Name="ProxyServerInput" Header="Server" Margin="0,8,0,0"/>
                        <TextBox x:Name="ProxyPortInput" Header="Port" InputScope="Number" Margin="0,8,0,0"/>
                        <TextBox x:Name="ProxySecretInput" Header="MTProto secret" Margin="0,8,0,0"/>
                        <TextBox x:Name="ProxyUsernameInput" Header="Username" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="ProxyPasswordInput" Header="Password" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Apply" Click="ProxyApplyButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Disable" Click="ProxyDisableButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Text="Phone number sign-in is used by default."
                           TextWrapping="Wrap"
                           Foreground="#FF374151"
                           Margin="0,14,0,0" />

                <Border Height="1" Background="#22000000" Margin="0,22,0,18" />

                <Button x:Name="ShowQrButton"
                        Content="Sign in with QR"
                        MinWidth="160"
                        HorizontalAlignment="Left"
                        Click="ShowQrButton_Click" />

                <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Open Telegram on your phone: Settings → Devices → Link Desktop Device. Point the camera at the QR code below."
                               TextWrapping="Wrap" FontSize="16" />

                    <Border Background="White" BorderBrush="#33000000" BorderThickness="1" Padding="12" HorizontalAlignment="Center" Margin="0,18,0,8">
                        <Image x:Name="QrImage" Width="280" Height="280" Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="QR token link:" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBox x:Name="TokenLinkBox" IsReadOnly="True" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="RefreshButton" Content="Refresh QR" MinWidth="140" Click="RefreshButton_Click" />
                        <Button x:Name="ResetButton" Content="Reset session" MinWidth="140" Click="ResetButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
