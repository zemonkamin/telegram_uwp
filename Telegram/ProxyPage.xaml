<Page
    x:Class="Telegram.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Telegram"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FF1B1B1B" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF9C9C9C" />
                    <SolidColorBrush x:Key="TelegramTileBrush" Color="#FF1B1B1B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TelegramTileBrush" Color="#FFEDEDED" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource TelegramPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="14,0"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiLight"
                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                Text="Proxy settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="18,12,18,28">
                <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiLight"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Text="Use proxy" />
                    <ToggleSwitch
                        x:Name="ProxyEnabledToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="ProxyEnabledToggle_Toggled" />
                </Grid>

                <StackPanel x:Name="ProxyListSection" Visibility="Collapsed">
                    <ListView
                        x:Name="ProxyListView"
                        Margin="0,8,0,0"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        IsItemClickEnabled="True"
                        ItemClick="ProxyListView_ItemClick"
                        ReorderMode="Enabled"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,4"
                                    Holding="ProxyItem_Holding"
                                    RightTapped="ProxyItem_RightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        Background="{ThemeResource TelegramTileBrush}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                            Text="{Binding Initial}" />
                                        <Grid Background="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                                Glyph="&#xE73E;" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="16"
                                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                            Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="ProxyAddButton"
                        Margin="0,4,0,0"
                        Padding="0,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ProxyAddButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Column="0"
                                Width="42"
                                Height="42"
                                Background="{ThemeResource TelegramTileBrush}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                    Glyph="&#xE710;" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="16"
                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                    Text="Add proxy" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                    Text="MTProto, SOCKS5 or HTTP" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="13"
                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                        Text="Proxy servers can help you connect to Telegram when it is blocked. Tap a proxy to connect, hold to edit or delete, and drag to reorder."
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Name="ProxyStatusText"
                    Margin="0,14,0,0"
                    FontSize="13"
                    Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
