<UserControl
    x:Class="Telegram.Controls.CommentsPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid MinHeight="33" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="CommentsPreviewAvatarBackgroundBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        </Grid.Resources>

        <Border Background="Transparent"
                Padding="7,5,7,5">
            <Grid MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding CommentAvatars}"
                                  Visibility="{Binding CommentAvatarsVisibility}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,-7,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="{ThemeResource CommentsPreviewAvatarBackgroundBrush}" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Initials}"
                                               Visibility="{Binding InitialsVisibility}"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="&#xE8BD;"
                               Visibility="{Binding CommentsGlyphVisibility}"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                               FontSize="20"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="1,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CommentsCountText}"
                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                           FontSize="20"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
