<UserControl
    x:Class="Telegram.Controls.FfmpegMusicPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MusicSeekSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#55999999" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="18" Margin="{TemplateBinding Padding}">
                            <Grid x:Name="HorizontalTemplate" MinHeight="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Rectangle
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="3"
                                    HorizontalAlignment="Stretch"
                                    Fill="{TemplateBinding Background}"
                                    IsHitTestVisible="False" />

                                <Rectangle
                                    x:Name="HorizontalTrackRect"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="3"
                                    HorizontalAlignment="Stretch"
                                    Fill="{TemplateBinding Background}" />

                                <Rectangle
                                    x:Name="HorizontalDecreaseRect"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Height="3"
                                    HorizontalAlignment="Stretch"
                                    Fill="{TemplateBinding Foreground}" />

                                <Rectangle
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Fill="{TemplateBinding Foreground}"
                                    IsHitTestVisible="False" />
                                <Rectangle
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="6"
                                    Height="3"
                                    HorizontalAlignment="Right"
                                    Fill="{TemplateBinding Background}"
                                    IsHitTestVisible="False" />

                                <Thumb
                                    x:Name="HorizontalThumb"
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    Width="10"
                                    Height="10"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="{TemplateBinding Foreground}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="MusicRoot"
        MinWidth="0"
        MaxWidth="264"
        Height="64"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Loaded="MusicRoot_Loaded"
        Unloaded="MusicRoot_Unloaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <MediaElement
            x:Name="Player"
            Width="1"
            Height="1"
            AreTransportControlsEnabled="False"
            AudioCategory="BackgroundCapableMedia"
            AutoPlay="False"
            CurrentStateChanged="Player_CurrentStateChanged"
            IsHitTestVisible="False"
            MediaEnded="Player_MediaEnded"
            MediaFailed="Player_MediaFailed"
            MediaOpened="Player_MediaOpened"
            Opacity="0" />

        <Button
            Grid.Column="0"
            Width="48"
            Height="48"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MusicPlayButton_Click">
            <Grid Width="48" Height="48">
                <Rectangle x:Name="MusicAccentBackground" Fill="#B8FFFFFF" />
                <Rectangle x:Name="MusicCoverEllipse" Opacity="0">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="MusicCoverBrush" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle
                    x:Name="MusicCoverShade"
                    Fill="#33000000"
                    Opacity="0"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="MusicBackgroundGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Symbol"
                    FontSize="26"
                    Foreground="#DD000000"
                    Opacity="0.5"
                    Text="&#x266A;"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="MusicCoverOverlay"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="#B8FFFFFF"
                    Opacity="0"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="MusicPlayGlyph"
                    Margin="1,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="13"
                    Foreground="#DD000000"
                    Text="&#xE768;" />
                <ProgressRing
                    x:Name="MusicLoadingRing"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#DD000000"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
        </Button>

        <Grid
            Grid.Column="1"
            MinWidth="0"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="MusicTitleText"
                Grid.Row="0"
                CharacterSpacing="-15"
                FontSize="18"
                FontWeight="SemiLight"
                Foreground="White"
                MaxLines="1"
                Text="Audio"
                TextTrimming="CharacterEllipsis" />

            <Grid
                Grid.Row="1"
                MinHeight="22"
                Margin="0,-3,0,0"
                Background="Transparent">
                <TextBlock
                    x:Name="MusicAuthorText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiLight"
                    Foreground="#AAFFFFFF"
                    MaxLines="1"
                    Text="Unknown artist"
                    TextTrimming="CharacterEllipsis" />

                <Grid
                    x:Name="MusicSeekLine"
                    Background="Transparent"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="MusicSeekRoot"
                        Grid.Column="0"
                        MinWidth="0"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Slider
                            x:Name="MusicSeekSlider"
                            MinWidth="0"
                            Height="18"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="#55999999"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                            IsEnabled="True"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.001"
                            Style="{StaticResource MusicSeekSliderStyle}"
                            Value="0" />

                        <Rectangle
                            x:Name="MusicSeekHitTarget"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Canvas.ZIndex="10"
                            Fill="Transparent"
                            PointerCanceled="MusicSeekHitTarget_PointerCanceled"
                            PointerCaptureLost="MusicSeekHitTarget_PointerCaptureLost"
                            PointerMoved="MusicSeekHitTarget_PointerMoved"
                            PointerPressed="MusicSeekHitTarget_PointerPressed"
                            PointerReleased="MusicSeekHitTarget_PointerReleased" />
                    </Grid>

                    <TextBlock
                        x:Name="MusicDurationText"
                        Grid.Column="1"
                        Width="50"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#AAFFFFFF"
                        Text="0:00"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
