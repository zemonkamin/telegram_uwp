<UserControl
    x:Class="Telegram.Controls.FfmpegAudioPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AudioSeekSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#66999999" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="{TemplateBinding Padding}" MinHeight="20">
                            <Grid x:Name="HorizontalTemplate" MinHeight="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Rectangle Fill="{TemplateBinding Background}"
                                           Height="4"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           HorizontalAlignment="Stretch"
                                           IsHitTestVisible="False" />

                                <Rectangle x:Name="HorizontalTrackRect"
                                           Fill="{TemplateBinding Background}"
                                           Height="4"
                                           Grid.Row="1"
                                           Grid.Column="2"
                                           HorizontalAlignment="Stretch" />

                                <Rectangle x:Name="HorizontalDecreaseRect"
                                           Fill="{TemplateBinding Foreground}"
                                           Height="4"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           HorizontalAlignment="Stretch" />

                                <Rectangle Fill="{TemplateBinding Foreground}"
                                           Height="4"
                                           Width="6"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False" />
                                <Rectangle Fill="{TemplateBinding Background}"
                                           Height="4"
                                           Width="6"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False" />

                                <Thumb x:Name="HorizontalThumb"
                                       Grid.Row="0"
                                       Grid.RowSpan="3"
                                       Grid.Column="1"
                                       Height="12"
                                       Width="12"
                                       Background="{TemplateBinding Foreground}"
                                       AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AudioBubbleRoot"
          Height="42"
          HorizontalAlignment="Left"
          Background="Transparent"
          Loaded="AudioBubbleRoot_Loaded"
          Unloaded="AudioBubbleRoot_Unloaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <MediaElement x:Name="Player"
                      Width="1"
                      Height="1"
                      Opacity="0"
                      IsHitTestVisible="False"
                      AreTransportControlsEnabled="False"
                      AutoPlay="False"
                      AudioCategory="Media"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      CurrentStateChanged="Player_CurrentStateChanged"
                      MediaFailed="Player_MediaFailed" />

        <Button Grid.Column="0"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Click="AudioPlayButton_Click">
            <Grid Width="36" Height="36">
                <Ellipse x:Name="AudioPlayCircle" Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                <TextBlock x:Name="AudioPlayGlyph"
                           Text="&#xE768;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="1,0,0,0" />
                <ProgressRing x:Name="AudioPlayLoadingRing"
                              Width="20"
                              Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="White"
                              IsActive="False"
                              Visibility="Collapsed" />
            </Grid>
        </Button>

        <Grid x:Name="AudioProgressRoot"
              Grid.Column="1"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="AudioSeekRoot"
                  Grid.Column="0"
                  Width="128"
                  Height="20"
                  VerticalAlignment="Center"
                  Background="Transparent">
                <Slider x:Name="AudioSeekSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        StepFrequency="0.001"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Height="20"
                        Padding="0"
                        IsEnabled="True"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        Background="#66999999"
                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                        Style="{StaticResource AudioSeekSliderStyle}" />

                <Rectangle x:Name="AudioSeekHitTarget"
                           Canvas.ZIndex="10"
                           Fill="Transparent"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           PointerPressed="AudioSeekHitTarget_PointerPressed"
                           PointerMoved="AudioSeekHitTarget_PointerMoved"
                           PointerReleased="AudioSeekHitTarget_PointerReleased"
                           PointerCanceled="AudioSeekHitTarget_PointerCanceled"
                           PointerCaptureLost="AudioSeekHitTarget_PointerCaptureLost" />
            </Grid>

            <TextBlock x:Name="AudioDurationText"
                       Grid.Column="1"
                       Text="0:00"
                       FontSize="11"
                       Foreground="#AAFFFFFF"
                       VerticalAlignment="Center"
                       TextAlignment="Left"
                       Margin="6,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
