<UserControl
    x:Class="Telegram.Controls.FfmpegVideoPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TelegramRoundMaskFallbackBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TelegramRoundMaskFallbackBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="TelegramMediaPlaceholderBrush" Color="#FFA6A6A6" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="{ThemeResource TelegramMediaPlaceholderBrush}"
        SizeChanged="Root_SizeChanged"
        Tapped="Root_Tapped">
        <MediaElement
            x:Name="Player"
            AreTransportControlsEnabled="True"
            AutoPlay="False"
            CurrentStateChanged="Player_CurrentStateChanged"
            Loaded="Player_Loaded"
            MediaEnded="Player_MediaEnded"
            MediaFailed="Player_MediaFailed"
            MediaOpened="Player_MediaOpened"
            Stretch="Uniform" />

        <Path
            x:Name="RoundMask"
            Fill="{ThemeResource TelegramRoundMaskFallbackBrush}"
            IsHitTestVisible="False"
            Stretch="Fill"
            Visibility="Collapsed" />

        <Ellipse
            x:Name="RoundBorder"
            IsHitTestVisible="False"
            Stroke="#55000000"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <Path
            x:Name="RoundProgressArc"
            IsHitTestVisible="False"
            Stroke="White"
            StrokeThickness="3"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            Visibility="Collapsed" />

        <Grid
            x:Name="RoundControls"
            Background="Transparent"
            Visibility="Collapsed">
            <Ellipse
                x:Name="RoundCenterButtonBackground"
                Width="54"
                Height="54"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="#99000000" />
            <TextBlock
                x:Name="RoundPlayGlyph"
                Margin="3,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="23"
                Foreground="White"
                Text="&#xE768;" />
            <ProgressRing
                x:Name="RoundLoadingRing"
                Width="42"
                Height="42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                IsActive="False"
                Visibility="Collapsed" />
            <Border
                x:Name="RoundTimeBadge"
                Height="23"
                MinWidth="54"
                Margin="0,0,0,12"
                Padding="8,2,8,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#99000000"
                CornerRadius="11"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="RoundTimeText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="0:00" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
