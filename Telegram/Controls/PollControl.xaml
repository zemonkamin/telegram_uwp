<UserControl
    x:Class="Telegram.Controls.PollControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PollBareButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <TransitionCollection />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent"
          Width="{Binding MediaPlaceholderWidth}"
          MaxWidth="{Binding BubbleMaxWidth}">
        <StackPanel Background="Transparent"
                    Margin="0,0,0,4">
            <TextBlock Text="{Binding StructuredMediaTitle}"
                       Foreground="{Binding MessageForeground}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="WrapWholeWords" />

            <TextBlock Text="{Binding PollStatusText}"
                       Visibility="{Binding PollStatusVisibility}"
                       Foreground="{Binding MessageSubtleForeground}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextWrapping="WrapWholeWords" />

            <ItemsControl ItemsSource="{Binding StructuredMediaItems}"
                          Visibility="{Binding StructuredMediaItemsVisibility}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PollBareButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Margin="0,0,0,7"
                                IsEnabled="{Binding IsEnabled}"
                                Click="PollOptionButton_Click">
                            <Grid Background="Transparent" MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding PollGlyph}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="19"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,0" />

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Foreground}"
                                               FontSize="14"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Visibility="{Binding SubtitleVisibility}"
                                               Foreground="{Binding SubtleForeground}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="WrapWholeWords" />
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding VotePercent}"
                                                 Height="3"
                                                 Margin="0,6,0,0"
                                                 Foreground="{Binding AccentBrush}"
                                                 Background="{Binding ProgressTrackBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PercentText}"
                                           Foreground="{Binding SubtleForeground}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,2,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource PollBareButtonStyle}"
                    HorizontalAlignment="Left"
                    Padding="0,4,0,4"
                    Margin="32,0,0,5"
                    Visibility="{Binding PollAddOptionVisibility}"
                    Click="AddOptionButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{Binding MessageAccentBrush}"
                               FontSize="14"
                               Margin="0,1,6,0" />
                    <TextBlock Text="Add option"
                               Foreground="{Binding MessageAccentBrush}"
                               FontSize="13" />
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding PollRecentVotersText}"
                       Visibility="{Binding PollRecentVotersVisibility}"
                       Foreground="{Binding MessageSubtleForeground}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       TextWrapping="WrapWholeWords" />

            <TextBlock Text="{Binding PollSolutionText}"
                       Visibility="{Binding PollSolutionVisibility}"
                       Foreground="{Binding MessageSubtleForeground}"
                       FontSize="11"
                       Margin="0,4,0,0"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</UserControl>
