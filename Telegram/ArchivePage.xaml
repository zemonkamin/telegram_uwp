<Page
    x:Class="Telegram.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF1B1B1B" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF8D8D8D" />
                    <SolidColorBrush x:Key="TimeTextBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#FF2E2E2E" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#FFEDEDED" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TimeTextBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#FFE1E1E1" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#FF333333" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar
            x:Name="TopLoadingBar"
            Grid.RowSpan="3"
            Canvas.ZIndex="100"
            Height="3"
            VerticalAlignment="Top"
            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <Grid Grid.Row="0" Padding="14,0,10,0" Background="{ThemeResource HeaderBackgroundBrush}">
            <TextBlock
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                FontSize="24"
                FontWeight="Light"
                Foreground="{ThemeResource PrimaryTextBrush}"
                Text="Archive" />
        </Grid>

        <ListView
            x:Name="ChatList"
            Grid.Row="1"
            Padding="0,2,0,2"
            Background="{ThemeResource PageBackgroundBrush}"
            BorderThickness="0"
            IsItemClickEnabled="True"
            ItemClick="ChatList_ItemClick"
            SelectionMode="None">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectedBackgroundThemeBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemPointerOverBackgroundThemeBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemPressedBackgroundThemeBrush" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid Background="Transparent">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="64" Padding="10,5,10,5" Background="Transparent" Holding="ListItem_Holding" RightTapped="ListItem_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="46" Height="46" Background="{ThemeResource AvatarPlaceholderBrush}" CornerRadius="23">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AvatarTextBrush}" Text="{Binding IconText}" />
                            </Border>
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiLight" Foreground="{ThemeResource PrimaryTextBrush}" MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" MaxLines="1" Text="{Binding DisplayLastMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <FontIcon Margin="0,0,4,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{ThemeResource TimeTextBrush}" Glyph="&#xE718;" Visibility="{Binding PinnedIconVisibility}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TimeTextBrush}" MaxLines="1" Text="{Binding LastTimeText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Background="{ThemeResource PageBackgroundBrush}">
            <Button
                x:Name="LoadMoreButton"
                Margin="10,6,10,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource HeaderBackgroundBrush}"
                BorderBrush="{ThemeResource SecondaryTextBrush}"
                Click="LoadMoreButton_Click"
                Content="Load more"
                Foreground="{ThemeResource PrimaryTextBrush}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Padding="12,6,12,8"
                FontSize="14"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Text=""
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
