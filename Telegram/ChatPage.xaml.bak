<Page
    x:Class="Telegram.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Telegram.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Telegram"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="TelegramHeaderBorderBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="TelegramPanelBorderBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="TelegramInputBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FFB3B3B3" />
                    <SolidColorBrush x:Key="TelegramSubtleTextBrush" Color="#FF9C9C9C" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="TelegramOverlayButtonBrush" Color="#BB050505" />
                    <SolidColorBrush x:Key="TelegramMediaPlaceholderBrush" Color="#FFA6A6A6" />
                    <SolidColorBrush x:Key="TelegramReplyBackgroundBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramAttachmentBackgroundBrush" Color="#FF151515" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="TelegramHeaderBorderBrush" Color="#FFDADADA" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="TelegramPanelBorderBrush" Color="#FFDADADA" />
                    <SolidColorBrush x:Key="TelegramInputBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TelegramSubtleTextBrush" Color="#FF7A7A7A" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="TelegramOverlayButtonBrush" Color="#EEFFFFFF" />
                    <SolidColorBrush x:Key="TelegramMediaPlaceholderBrush" Color="#FFE7E7E7" />
                    <SolidColorBrush x:Key="TelegramReplyBackgroundBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="TelegramAttachmentBackgroundBrush" Color="#FFEFEFEF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TelegramBareButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TelegramFullWidthTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChatComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0,14,4,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="Transparent">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    HorizontalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DateSeparatorTemplate">
                <Grid Padding="0,6,0,6" HorizontalAlignment="Stretch">
                    <Border
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="12"
                        Padding="12,4,12,4">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="{Binding DateText}"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ServiceMessageTemplate">
                <Grid Padding="0,4,0,4" HorizontalAlignment="Stretch">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiLight"
                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Text="{Binding ServiceActionText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>

            <local:DateSeparatorVisibilityConverter x:Key="DateSeparatorVisibilityConverter" />
            <local:ServiceMessageVisibilityConverter x:Key="ServiceMessageVisibilityConverter" />
            <local:NormalMessageVisibilityConverter x:Key="NormalMessageVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{ThemeResource TelegramPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar
            x:Name="TopLoadingBar"
            Grid.RowSpan="3"
            Height="3"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <Border
            Grid.Row="0"
            Margin="0,0,-2,0"
            Background="{ThemeResource TelegramHeaderBackgroundBrush}"
            BorderBrush="{ThemeResource TelegramHeaderBorderBrush}"
            BorderThickness="0,0,0,1"
            Tapped="Header_Tapped">
            <Grid Margin="5,4,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Width="42"
                    Height="42"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="42"
                        Height="42"
                        Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                    <Ellipse Width="42" Height="42">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="HeaderAvatar" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock
                        x:Name="HeaderInitials"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderTitle"
                        FontSize="17"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Text="Chat"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="HeaderSubtitle"
                        Margin="0,-1,0,0"
                        FontSize="13"
                        FontWeight="SemiLight"
                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                        Text="last seen recently"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="HeaderMoreButton"
                    Grid.Column="2"
                    Width="38"
                    Height="42"
                    Margin="0,4,0,3"
                    VerticalAlignment="Center"
                    Click="HeaderMoreButton_Click"
                    Style="{StaticResource TelegramBareButtonStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Opacity="0.75"
                        Text="&#xE712;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{ThemeResource TelegramPageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="PinnedMessageBar"
                Grid.Row="0"
                Background="{ThemeResource TelegramHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource TelegramHeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <Grid MinHeight="46" Padding="0,3,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource SystemControlHighlightAccentBrush}" />
                    <Grid
                        Grid.Column="1"
                        Margin="10,0,8,0"
                        Background="Transparent"
                        Tapped="PinnedMessageBar_Tapped">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PinnedMessageTitle"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                Text="Pinned Message"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="PinnedMessageText"
                                Margin="0,-1,0,0"
                                FontSize="14"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="PinnedMessageCounter"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TelegramSubtleTextBrush}"
                        Text="" />
                    <Button
                        x:Name="PinnedPreviousButton"
                        Grid.Column="3"
                        Width="36"
                        Height="42"
                        Click="PinnedPreviousButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="&#xE70E;" />
                    </Button>
                    <Button
                        x:Name="PinnedNextButton"
                        Grid.Column="4"
                        Width="36"
                        Height="42"
                        Click="PinnedNextButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="&#xE70D;" />
                    </Button>
                </Grid>
            </Border>

            <Border
                x:Name="ChatWallpaper"
                Grid.Row="1"
                Visibility="Collapsed" />

            <Rectangle
                x:Name="ChatWallpaperDim"
                Grid.Row="1"
                Fill="Black"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed" />

            <ListView
                x:Name="MessageList"
                Grid.Row="1"
                Padding="0,4,0,6"
                Background="Transparent"
                BorderThickness="0"
                IsItemClickEnabled="False"
                Opacity="0"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <TransitionCollection />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Date separator -->
                            <Grid
                                Padding="0,6,0,6"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Converter={StaticResource DateSeparatorVisibilityConverter}}">
                                <Border
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="12"
                                    Padding="12,4,12,4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiLight"
                                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                        Text="{Binding DateText}"
                                        TextAlignment="Center" />
                                </Border>
                            </Grid>
                            <!-- Service message -->
                            <Grid
                                Padding="0,4,0,4"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Converter={StaticResource ServiceMessageVisibilityConverter}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiLight"
                                    Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                    HorizontalAlignment="Center"
                                    Text="{Binding ServiceActionText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <!-- Normal message -->
                            <Grid
                                Padding="0,2,0,2"
                                Background="Transparent"
                                Holding="MessageRoot_Holding"
                                RightTapped="MessageRoot_RightTapped"
                                Tag="{Binding}"
                                Visibility="{Binding Converter={StaticResource NormalMessageVisibilityConverter}}">
                            <Grid
                                Width="34"
                                Height="34"
                                Margin="7,1,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Tag="{Binding}"
                                Tapped="SenderProfile_Tapped"
                                Visibility="{Binding AvatarVisibility}">
                                <Ellipse
                                    Width="34"
                                    Height="34"
                                    Fill="{ThemeResource TelegramAvatarPlaceholderBrush}" />
                                <Ellipse Width="34" Height="34">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SenderAvatarImageSource}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding SenderInitials}"
                                    Visibility="{Binding SenderInitialsVisibility}" />
                            </Grid>

                            <Grid Margin="{Binding BubbleMargin}" HorizontalAlignment="{Binding BubbleAlignment}">
                                <Path
                                    Width="10"
                                    Height="12"
                                    Margin="-9,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Data="M 10,0 L 10,12 L 0,0 Z"
                                    Fill="{Binding BubbleBackground}"
                                    Stretch="Fill"
                                    Visibility="{Binding IncomingTailVisibility}" />

                                <Border
                                    MaxWidth="{Binding BubbleMaxWidth}"
                                    Padding="{Binding BubblePadding}"
                                    HorizontalAlignment="Left"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorderBrush}"
                                    BorderThickness="{Binding BubbleBorderThickness}"
                                    CornerRadius="0">
                                    <Grid>
                                        <StackPanel Margin="{Binding BubbleContentMargin}">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFD05A5A"
                                                Tag="{Binding}"
                                                Tapped="SenderProfile_Tapped"
                                                Text="{Binding SenderName}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding SenderVisibility}" />

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,0,0,0"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Visibility="{Binding ForwardedVisibility}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{Binding MessageSubtleForeground}"
                                                    Text="{Binding ForwardedFrom}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Border>

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,1,0,2"
                                                Background="Transparent"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Tag="{Binding}"
                                                Tapped="ReplyPreview_Tapped"
                                                Visibility="{Binding ReplyToVisibility}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding MessageAccentBrush}"
                                                        MaxLines="1"
                                                        Text="{Binding ReplyToSenderDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="ReplyPreviewText"
                                                        DataContextChanged="LocalEmojiTextBlock_DataContextChanged"
                                                        FontSize="11"
                                                        Foreground="{Binding MessageSubtleForeground}"
                                                        Loaded="LocalEmojiTextBlock_Loaded"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>

                                            <controls:PollControl
                                                Margin="0,0,0,4"
                                                Visibility="{Binding PollVisibility}"
                                                VoteRequested="PollControl_VoteRequested" />

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="10"
                                                Background="{ThemeResource TelegramReplyBackgroundBrush}"
                                                Visibility="{Binding StructuredMediaVisibility}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding MessageForeground}"
                                                        Text="{Binding StructuredMediaTitle}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{Binding MessageSubtleForeground}"
                                                        Text="{Binding StructuredMediaSubtitle}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding StructuredMediaSubtitleVisibility}" />
                                                    <TextBlock
                                                        x:Name="StructuredMediaTextBlock"
                                                        Margin="0,6,0,0"
                                                        DataContextChanged="LocalEmojiTextBlock_DataContextChanged"
                                                        FontSize="13"
                                                        Foreground="{Binding MessageForeground}"
                                                        Loaded="LocalEmojiTextBlock_Loaded"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding StructuredMediaTextVisibility}" />
                                                    <ItemsControl
                                                        Margin="0,6,0,0"
                                                        ItemsSource="{Binding StructuredMediaItems}"
                                                        Visibility="{Binding StructuredMediaItemsVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button
                                                                    Margin="0,2,0,0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Click="StructuredMediaItem_Click"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Style="{StaticResource TelegramBareButtonStyle}">
                                                                    <Grid MinHeight="32" Background="Transparent">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="28" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="18"
                                                                            Foreground="{Binding SubtleForeground}"
                                                                            Text="{Binding Glyph}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Foreground="{Binding Foreground}"
                                                                            Text="{Binding DisplayText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Grid
                                                Width="{Binding MediaPlaceholderWidth}"
                                                MinHeight="54"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Visibility="{Binding FileVisibility}">

                                                <!--  Idle/ready state: this whole block disappears while downloading.  -->
                                                <Grid MinHeight="54" Visibility="{Binding FileIdleVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button
                                                        Width="39"
                                                        Height="39"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Click="DownloadFileButton_Click"
                                                        IsEnabled="{Binding DownloadButtonEnabled}"
                                                        Style="{StaticResource TelegramBareButtonStyle}"
                                                        Tag="{Binding}">
                                                        <Grid Width="39" Height="39">
                                                            <Ellipse Fill="{Binding FileDownloadBackgroundBrush}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="19"
                                                                Foreground="{Binding FileDownloadForegroundBrush}"
                                                                Text="&#xE118;" />
                                                        </Grid>
                                                    </Button>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding MessageForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="13"
                                                            Foreground="{Binding MessageSubtleForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileSubtitle}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  Download state: replaces the complete idle file block.  -->
                                                <Grid MinHeight="54" Visibility="{Binding FileDownloadProgressVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Width="39"
                                                        Height="39"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                        <Ellipse Fill="{Binding FileDownloadBackgroundBrush}" />
                                                        <ProgressRing
                                                            Width="25"
                                                            Height="25"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding FileDownloadForegroundBrush}"
                                                            IsActive="True" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding MessageForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,2,0,4"
                                                            FontSize="12"
                                                            Foreground="{Binding MessageSubtleForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileDownloadProgressText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <ProgressBar
                                                            Height="4"
                                                            Background="{ThemeResource TelegramPanelBorderBrush}"
                                                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                                            IsIndeterminate="{Binding FileDownloadIndeterminate}"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Value="{Binding FileDownloadProgressValue}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <Button
                                                Width="{Binding MediaRenderWidth}"
                                                Height="{Binding MediaDownloadPlaceholderHeight}"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Margin="0,0,0,4"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Click="DownloadMediaButton_Click"
                                                IsEnabled="{Binding DownloadButtonEnabled}"
                                                Style="{StaticResource TelegramBareButtonStyle}"
                                                Tag="{Binding}"
                                                Visibility="{Binding MediaDownloadPlaceholderVisibility}">
                                                <Grid
                                                    Width="{Binding MediaRenderWidth}"
                                                    Height="{Binding MediaDownloadPlaceholderHeight}"
                                                    Background="{ThemeResource TelegramMediaPlaceholderBrush}">
                                                    <Image
                                                        Width="{Binding MediaRenderWidth}"
                                                        Height="{Binding MediaDownloadPlaceholderHeight}"
                                                        ImageOpened="MediaPreviewImage_Opened"
                                                        Source="{Binding MediaPreviewImageSource}"
                                                        Stretch="UniformToFill"
                                                        Visibility="{Binding MediaPreviewVisibility}" />
                                                    <Border Background="#66000000" />
                                                    <ProgressRing
                                                        Width="44"
                                                        Height="44"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="White"
                                                        IsActive="True"
                                                        Visibility="{Binding MediaDownloadPlaceholderProgressVisibility}" />
                                                    <Grid
                                                        Width="112"
                                                        Height="44"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding VideoDownloadProgressBarVisibility}">
                                                        <Border Background="#AA000000" />
                                                        <TextBlock
                                                            Margin="0,0,0,10"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding VideoDownloadProgressText}" />
                                                        <ProgressBar
                                                            Width="84"
                                                            Height="4"
                                                            Margin="0,0,0,10"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom"
                                                            Background="#66000000"
                                                            Foreground="White"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Value="{Binding VideoDownloadProgressValue}" />
                                                    </Grid>
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MediaDownloadPlaceholderIconVisibility}">
                                                        <TextBlock
                                                            Margin="0,0,0,5"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="26"
                                                            Foreground="White"
                                                            Text="&#xE118;" />
                                                        <TextBlock
                                                            MaxWidth="{Binding MediaDownloadTextWidth}"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="{Binding DownloadButtonText}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <Image
                                                Width="{Binding MediaPlaceholderWidth}"
                                                MaxHeight="420"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                ImageOpened="PhotoImage_Opened"
                                                Source="{Binding PhotoImageSource}"
                                                Stretch="Uniform"
                                                Tapped="ChatPhoto_Tapped"
                                                Visibility="{Binding PhotoVisibility}" />

                                            <controls:FfmpegVideoPlayerControl
                                                Width="{Binding MediaRenderWidth}"
                                                Height="{Binding MediaDownloadPlaceholderHeight}"
                                                Margin="0,0,0,4"
                                                IsDownloading="{Binding IsMediaDownloading}"
                                                MediaKind="{Binding MediaKind}"
                                                PlayerStretch="UniformToFill"
                                                SourceUri="{Binding MediaFileUri}"
                                                Visibility="{Binding VideoVisibility}" />

                                            <MediaElement
                                                Width="{Binding GifRenderWidth}"
                                                Height="{Binding GifRenderHeight}"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                AreTransportControlsEnabled="False"
                                                AutoPlay="True"
                                                MediaEnded="GifMediaElement_MediaEnded"
                                                MediaFailed="MediaElement_MediaFailed"
                                                Source="{Binding MediaUri}"
                                                Stretch="UniformToFill"
                                                Visibility="{Binding GifVisibility}" />

                                            <Grid
                                                Width="196"
                                                Height="196"
                                                Margin="0,0,0,4"
                                                Background="{ThemeResource TelegramReplyBackgroundBrush}"
                                                Visibility="{Binding RoundVideoVisibility}">
                                                <Ellipse
                                                    Width="196"
                                                    Height="196"
                                                    Fill="{ThemeResource TelegramMediaPlaceholderBrush}" />
                                                <controls:FfmpegVideoPlayerControl
                                                    Width="196"
                                                    Height="196"
                                                    IsDownloading="{Binding IsMediaDownloading}"
                                                    MediaKind="{Binding MediaKind}"
                                                    PlayerStretch="UniformToFill"
                                                    SourceUri="{Binding MediaFileUri}" />
                                                <Ellipse
                                                    Width="196"
                                                    Height="196"
                                                    IsHitTestVisible="False"
                                                    Stroke="#33000000"
                                                    StrokeThickness="1" />
                                            </Grid>

                                            <Image
                                                Width="196"
                                                Height="196"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                Source="{Binding MediaFallbackUri}"
                                                Stretch="Uniform"
                                                Visibility="{Binding StaticEmojiVisibility}" />

                                            <controls:FfmpegStickerImageControl
                                                Width="196"
                                                Height="196"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                ExpectedDurationSeconds="{Binding MediaDurationSeconds}"
                                                FallbackUri="{Binding MediaFallbackUri}"
                                                ImageStretch="Uniform"
                                                MediaKind="{Binding MediaKind}"
                                                SourceUri="{Binding MediaFileUri}"
                                                Visibility="{Binding StickerVisibility}" />

                                            <controls:FfmpegAudioPlayerControl
                                                Height="42"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                DurationSeconds="{Binding MediaDurationSeconds}"
                                                IsDownloading="{Binding IsMediaDownloading}"
                                                MediaKind="{Binding MediaKind}"
                                                PlaybackEnded="FfmpegAudioPlayer_PlaybackEnded"
                                                SourceRequested="FfmpegAudioPlayer_SourceRequested"
                                                SourceUri="{Binding MediaFileUri}"
                                                Visibility="{Binding VoiceVisibility}" />

                                            <controls:FfmpegMusicPlayerControl
                                                Height="64"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                DurationSeconds="{Binding MediaDurationSeconds}"
                                                IsDownloading="{Binding IsMediaDownloading}"
                                                MediaKind="{Binding MediaKind}"
                                                SourceRequested="FfmpegAudioPlayer_SourceRequested"
                                                SourceUri="{Binding MediaFileUri}"
                                                Visibility="{Binding MusicVisibility}" />

                                            <ItemsControl
                                                Width="{Binding MediaPlaceholderWidth}"
                                                Margin="0,0,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding MediaItemRows}"
                                                Visibility="{Binding MediaItemsLoadedVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl Margin="0,0,0,3" ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid
                                                                        Width="{Binding AlbumTileWidth}"
                                                                        Height="{Binding AlbumTileHeight}"
                                                                        Margin="0,0,3,3"
                                                                        Background="Transparent">

                                                                        <Grid
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="56"
                                                                            Background="Transparent"
                                                                            Visibility="{Binding GroupedFileVisibility}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="50" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <Grid
                                                                                Grid.ColumnSpan="2"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding GroupedFileDownloadProgressVisibility}">
                                                                                <ProgressBar
                                                                                    Height="4"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{ThemeResource TelegramPanelBorderBrush}"
                                                                                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                                                                    IsIndeterminate="{Binding GroupedFileDownloadIndeterminate}"
                                                                                    Maximum="100"
                                                                                    Minimum="0"
                                                                                    Value="{Binding GroupedFileDownloadProgressValue}" />
                                                                                <TextBlock
                                                                                    Margin="0,0,0,2"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Bottom"
                                                                                    FontSize="11"
                                                                                    Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                                                                    Text="{Binding GroupedFileDownloadProgressText}" />
                                                                            </Grid>

                                                                            <Button
                                                                                Width="39"
                                                                                Height="39"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Click="DownloadMediaItemButton_Click"
                                                                                IsEnabled="{Binding DownloadButtonEnabled}"
                                                                                Style="{StaticResource TelegramBareButtonStyle}"
                                                                                Tag="{Binding}"
                                                                                Visibility="{Binding GroupedFileIdleVisibility}">
                                                                                <Grid Width="39" Height="39">
                                                                                    <Ellipse Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                                                                                    <TextBlock
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontFamily="Segoe MDL2 Assets"
                                                                                        FontSize="19"
                                                                                        Foreground="White"
                                                                                        Text="&#xE118;" />
                                                                                </Grid>
                                                                            </Button>

                                                                            <StackPanel
                                                                                Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding GroupedFileIdleVisibility}">
                                                                                <TextBlock
                                                                                    FontSize="17"
                                                                                    FontWeight="SemiBold"
                                                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                                                    MaxLines="1"
                                                                                    Text="{Binding GroupedFileDisplayName}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock
                                                                                    Margin="0,4,0,0"
                                                                                    FontSize="13"
                                                                                    Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                                                                    MaxLines="1"
                                                                                    Text="{Binding GroupedFileSubtitle}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Image
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            Source="{Binding PhotoImageSource}"
                                                                            Stretch="UniformToFill"
                                                                            Tapped="ChatPhoto_Tapped"
                                                                            Visibility="{Binding PhotoVisibility}" />

                                                                        <Grid
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            Visibility="{Binding VideoVisibility}">
                                                                            <controls:FfmpegVideoPlayerControl
                                                                                Width="{Binding AlbumTileWidth}"
                                                                                Height="{Binding AlbumTileHeight}"
                                                                                IsDownloading="{Binding IsMediaDownloading}"
                                                                                MediaKind="{Binding MediaKind}"
                                                                                PlayerStretch="UniformToFill"
                                                                                SourceUri="{Binding MediaFileUri}" />
                                                                        </Grid>

                                                                        <MediaElement
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            AreTransportControlsEnabled="False"
                                                                            AutoPlay="True"
                                                                            MediaEnded="GifMediaElement_MediaEnded"
                                                                            MediaFailed="MediaElement_MediaFailed"
                                                                            Source="{Binding MediaUri}"
                                                                            Stretch="UniformToFill"
                                                                            Visibility="{Binding GifVisibility}" />

                                                                        <Grid
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            Visibility="{Binding RoundVideoVisibility}">
                                                                            <controls:FfmpegVideoPlayerControl
                                                                                Width="{Binding AlbumTileWidth}"
                                                                                Height="{Binding AlbumTileHeight}"
                                                                                IsDownloading="{Binding IsMediaDownloading}"
                                                                                MediaKind="{Binding MediaKind}"
                                                                                PlayerStretch="UniformToFill"
                                                                                SourceUri="{Binding MediaFileUri}" />
                                                                        </Grid>

                                                                        <Border
                                                                            Padding="8"
                                                                            Background="{ThemeResource TelegramReplyBackgroundBrush}"
                                                                            Visibility="{Binding AudioVisibility}">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock
                                                                                    Margin="0,0,0,6"
                                                                                    HorizontalAlignment="Center"
                                                                                    FontFamily="Segoe MDL2 Assets"
                                                                                    FontSize="26"
                                                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                                                    Text="&#xE189;" />
                                                                                <TextBlock
                                                                                    FontSize="12"
                                                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                                                    Text="{Binding MediaTitle}"
                                                                                    TextAlignment="Center"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <controls:FfmpegStickerImageControl
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            ExpectedDurationSeconds="{Binding MediaDurationSeconds}"
                                                                            FallbackUri="{Binding MediaFallbackUri}"
                                                                            ImageStretch="Uniform"
                                                                            MediaKind="{Binding MediaKind}"
                                                                            SourceUri="{Binding MediaFileUri}"
                                                                            Visibility="{Binding StickerVisibility}" />

                                                                        <Border
                                                                            Padding="8"
                                                                            Background="{ThemeResource TelegramReplyBackgroundBrush}"
                                                                            Visibility="{Binding AlbumFallbackVisibility}">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock
                                                                                    Margin="0,0,0,6"
                                                                                    HorizontalAlignment="Center"
                                                                                    FontFamily="Segoe MDL2 Assets"
                                                                                    FontSize="26"
                                                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                                                    Text="{Binding AlbumIconGlyph}" />
                                                                                <TextBlock
                                                                                    FontSize="12"
                                                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                                                    Text="{Binding MediaTitle}"
                                                                                    TextAlignment="Center"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Button
                                                                            Width="{Binding AlbumTileWidth}"
                                                                            Height="{Binding AlbumTileHeight}"
                                                                            MinWidth="0"
                                                                            MinHeight="0"
                                                                            Padding="0"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Stretch"
                                                                            Click="DownloadMediaItemButton_Click"
                                                                            IsEnabled="{Binding DownloadButtonEnabled}"
                                                                            Style="{StaticResource TelegramBareButtonStyle}"
                                                                            Tag="{Binding}"
                                                                            Visibility="{Binding AlbumDownloadButtonVisibility}">
                                                                            <Grid
                                                                                Width="{Binding AlbumTileWidth}"
                                                                                Height="{Binding AlbumTileHeight}"
                                                                                Background="#66000000">
                                                                                <Image
                                                                                    Width="{Binding AlbumTileWidth}"
                                                                                    Height="{Binding AlbumTileHeight}"
                                                                                    ImageOpened="MediaPreviewImage_Opened"
                                                                                    Source="{Binding MediaPreviewImageSource}"
                                                                                    Stretch="Uniform"
                                                                                    Visibility="{Binding MediaPreviewVisibility}" />
                                                                                <Border Background="#66000000" />
                                                                                <ProgressRing
                                                                                    Width="36"
                                                                                    Height="36"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="White"
                                                                                    IsActive="True"
                                                                                    Visibility="{Binding DownloadingVisibility}" />
                                                                                <Grid
                                                                                    Width="76"
                                                                                    Height="38"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding DownloadProgressBarVisibility}">
                                                                                    <Border Background="#AA000000" />
                                                                                    <TextBlock
                                                                                        Margin="0,0,0,9"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="12"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="White"
                                                                                        Text="{Binding DownloadProgressText}" />
                                                                                    <ProgressBar
                                                                                        Width="54"
                                                                                        Height="4"
                                                                                        Margin="0,0,0,8"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Bottom"
                                                                                        Background="#66000000"
                                                                                        Foreground="White"
                                                                                        Maximum="100"
                                                                                        Minimum="0"
                                                                                        Value="{Binding DownloadProgressValue}" />
                                                                                </Grid>
                                                                                <StackPanel
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding DownloadIconVisibility}">
                                                                                    <TextBlock
                                                                                        Margin="0,0,0,4"
                                                                                        HorizontalAlignment="Center"
                                                                                        FontFamily="Segoe MDL2 Assets"
                                                                                        FontSize="22"
                                                                                        Foreground="White"
                                                                                        Text="&#xE118;" />
                                                                                    <TextBlock
                                                                                        MaxWidth="{Binding AlbumDownloadTextWidth}"
                                                                                        FontSize="11"
                                                                                        Foreground="White"
                                                                                        Text="{Binding DownloadButtonText}"
                                                                                        TextAlignment="Center"
                                                                                        TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock
                                                x:Name="MessageMarkdownText"
                                                Margin="{Binding CaptionMargin}"
                                                DataContextChanged="MessageMarkdownText_DataContextChanged"
                                                FontSize="16"
                                                Foreground="{Binding MessageForeground}"
                                                Loaded="MessageMarkdownText_Loaded"
                                                Tag="{Binding}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{Binding TextVisibility}" />

                                            <ItemsControl
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding Reactions}"
                                                Visibility="{Binding ReactionsVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ReactionWrapPanel ItemSpacing="6" LineSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Margin="0"
                                                            Padding="0"
                                                            Click="ReactionButton_Click"
                                                            Style="{StaticResource TelegramBareButtonStyle}">
                                                            <Border
                                                                MinWidth="54"
                                                                MinHeight="30"
                                                                Padding="9,1,9,2"
                                                                Background="{Binding ChipBackground}"
                                                                CornerRadius="0">
                                                                <StackPanel
                                                                    Margin="0,-1,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <controls:FfmpegStickerImageControl
                                                                        Width="22"
                                                                        Height="22"
                                                                        Margin="0,0,6,0"
                                                                        ImageStretch="Uniform"
                                                                        MediaKind="sticker"
                                                                        SourceUri="{Binding CustomEmojiUri}"
                                                                        Visibility="{Binding CustomEmojiVisibility}" />
                                                                    <TextBlock
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="17"
                                                                        Text="{Binding DisplayText}"
                                                                        Visibility="{Binding EmoticonVisibility}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="16"
                                                                        Foreground="{Binding ChipForeground}"
                                                                        Text="{Binding CountText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding InlineKeyboardRows}"
                                                Visibility="{Binding InlineKeyboardVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl
                                                            Margin="0,0,0,4"
                                                            HorizontalAlignment="Stretch"
                                                            ItemsSource="{Binding Buttons}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        MinWidth="82"
                                                                        MinHeight="36"
                                                                        MaxWidth="190"
                                                                        Margin="0,0,4,0"
                                                                        Padding="10,4"
                                                                        HorizontalContentAlignment="Center"
                                                                        Click="BotInlineButton_Click"
                                                                        Content="{Binding Text}"
                                                                        Style="{StaticResource TelegramFullWidthTextButtonStyle}"
                                                                        Tag="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <controls:CommentsPreviewControl
                                                Margin="0,4,0,0"
                                                Tag="{Binding}"
                                                Tapped="CommentsPreview_Tapped"
                                                Visibility="{Binding CommentsPreviewVisibility}" />

                                        </StackPanel>

                                        <StackPanel
                                            Margin="{Binding FooterMargin}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Visibility="{Binding FooterVisibility}">
                                            <Image
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,4,0"
                                                Source="{Binding StateIconSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding OutgoingStateVisibility}" />
                                            <TextBlock
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                FontSize="11"
                                                Foreground="{Binding MessageSubtleForeground}"
                                                MaxLines="1"
                                                Text="{Binding FooterText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Path
                                    Width="10"
                                    Height="12"
                                    Margin="0,0,-9,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Data="M 0,0 L 0,12 L 10,0 Z"
                                    Fill="{Binding BubbleBackground}"
                                    Stretch="Fill"
                                    Visibility="{Binding OutgoingTailVisibility}" />
                            </Grid>
                        </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="ScrollDownButton"
                Grid.Row="1"
                Width="58"
                Height="58"
                Margin="0,0,15,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="ScrollDownButton_Click"
                Style="{StaticResource TelegramBareButtonStyle}"
                Visibility="Collapsed">
                <Grid Width="58" Height="58">
                    <Ellipse
                        Width="54"
                        Height="54"
                        Fill="{ThemeResource TelegramOverlayButtonBrush}"
                        Stroke="{ThemeResource TelegramPanelBorderBrush}"
                        StrokeThickness="2" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="30"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Text="&#xE74B;" />
                    <Border
                        x:Name="ScrollDownUnreadBadge"
                        Height="20"
                        MinWidth="20"
                        Margin="0,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ScrollDownUnreadText"
                            Margin="6,-1,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="White"
                            Text="" />
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource TelegramPanelBackgroundBrush}"
            BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ReplyPanel"
                    Grid.Row="0"
                    Margin="10,8,10,0"
                    Padding="8"
                    Background="{ThemeResource TelegramReplyBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="3,0,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ReplyPreviewText"
                            FontSize="13"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="Reply"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="30"
                            Click="CancelReplyButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                Text="×" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="AttachmentPreviewScroll"
                    Grid.Row="1"
                    Height="88"
                    Margin="8,6,8,0"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="AttachmentPreviewList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="76"
                                    Height="76"
                                    Margin="0,0,8,0">
                                    <Border Background="{ThemeResource TelegramAttachmentBackgroundBrush}" CornerRadius="2">
                                        <Image
                                            Width="76"
                                            Height="76"
                                            Source="{Binding Preview}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <Border
                                        Height="20"
                                        VerticalAlignment="Bottom"
                                        Background="#99000000">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="White"
                                            Text="{Binding KindLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="0,-4,-4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="RemoveAttachmentButton_Click"
                                        Style="{StaticResource TelegramBareButtonStyle}">
                                        <Grid Width="28" Height="28">
                                            <Ellipse Fill="#CC000000" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="&#xE711;" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid
                    x:Name="ComposerPanel"
                    Grid.Row="2"
                    Height="56"
                    MinHeight="56"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AttachColumn" Width="44" />
                        <ColumnDefinition x:Name="SendColumn" Width="56" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        MinHeight="56"
                        Margin="0,0,4,0"
                        VerticalAlignment="Stretch"
                        Background="Transparent">
                        <TextBox
                            x:Name="MessageText"
                            MinHeight="56"
                            MaxHeight="120"
                            Margin="42,0,0,0"
                            VerticalAlignment="Bottom"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            GotFocus="MessageText_GotFocus"
                            Style="{StaticResource ChatComposerTextBoxStyle}"
                            Tapped="MessageText_Tapped"
                            TextChanged="MessageText_TextChanged"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BotMenuButton"
                            Grid.Column="0"
                            Width="42"
                            Height="56"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="BotMenuButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}"
                            Visibility="Collapsed">
                            <Button.Transitions>
                                <TransitionCollection />
                            </Button.Transitions>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="22"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.82"
                                Text="&#xE712;" />
                        </Button>
                        <Button
                            x:Name="AttachButton"
                            Grid.Column="0"
                            Width="42"
                            Height="56"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="AttachButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}">
                            <Button.Transitions>
                                <TransitionCollection />
                            </Button.Transitions>
                            <TextBlock
                                x:Name="AttachIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.6"
                                Text="&#xE723;" />
                        </Button>
                        <TextBlock
                            x:Name="MessageWatermark"
                            Margin="48,0,0,18"
                            VerticalAlignment="Bottom"
                            FontSize="16"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSubtleTextBrush}"
                            IsHitTestVisible="False"
                            Text="Type a message" />
                        <TextBlock
                            x:Name="VoiceCancelHint"
                            Margin="42,0,0,18"
                            VerticalAlignment="Bottom"
                            FontSize="16"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            IsHitTestVisible="False"
                            Text="&lt; Cancel"
                            Visibility="Collapsed" />
                    </Grid>

                    <Button
                        x:Name="EmojiButton"
                        Grid.Column="1"
                        Width="42"
                        Height="56"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Click="EmojiButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <Button.Transitions>
                            <TransitionCollection />
                        </Button.Transitions>
                        <TextBlock
                            x:Name="EmojiButtonIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            Opacity="0.6"
                            Text="&#xE76E;" />
                    </Button>

                    <Button
                        x:Name="SendButton"
                        Grid.Column="2"
                        Width="56"
                        Height="56"
                        Margin="0"
                        VerticalAlignment="Center"
                        Click="SendButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <Button.Transitions>
                            <TransitionCollection />
                        </Button.Transitions>
                        <Grid Width="56" Height="56">
                            <Border
                                x:Name="SendButtonAccentBackground"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="SendIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.6"
                                Text="&#xE720;" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid
                    x:Name="ReadOnlyPanel"
                    Grid.Row="2"
                    Height="56"
                    Margin="0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ReadOnlyText"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TelegramSubtleTextBrush}"
                        Text="Sending messages is not available in this chat."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="ToggleNotificationsButton"
                        Grid.Column="1"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="ToggleNotificationsButton_Click"
                        Content="Turn off notifications"
                        FontSize="15"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Style="{StaticResource TelegramFullWidthTextButtonStyle}" />
                </Grid>

                <Border
                    x:Name="BotReplyKeyboardPanel"
                    Grid.Row="3"
                    MaxHeight="240"
                    Padding="8,6,8,8"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                        <ItemsControl x:Name="BotReplyKeyboardRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding Buttons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    MinWidth="92"
                                                    MinHeight="40"
                                                    MaxWidth="220"
                                                    Margin="2,0"
                                                    Padding="10,5"
                                                    HorizontalContentAlignment="Center"
                                                    Click="BotReplyKeyboardButton_Click"
                                                    Content="{Binding Text}"
                                                    Style="{StaticResource TelegramFullWidthTextButtonStyle}"
                                                    Tag="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border
                    x:Name="EmojiKeyboardPanel"
                    Grid.Row="3"
                    Height="260"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="StickerSetTabsList"
                            Grid.Row="0"
                            Margin="4,0"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionChanged="StickerSetTabsList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        MaxWidth="116"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                        Text="{Binding DisplayTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="1">
                            <GridView
                                x:Name="StickerItemsControl"
                                Width="320"
                                MaxWidth="320"
                                Margin="0,4,0,8"
                                HorizontalAlignment="Center"
                                IsItemClickEnabled="False"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.IsVerticalRailEnabled="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Width" Value="76" />
                                        <Setter Property="Height" Value="76" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            HorizontalAlignment="Left"
                                            ItemHeight="76"
                                            ItemWidth="76"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="76"
                                            Height="76"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Click="StickerItem_Click"
                                            Tag="{Binding}">
                                            <controls:FfmpegStickerImageControl
                                                Width="64"
                                                Height="64"
                                                ImageStretch="Uniform"
                                                MediaKind="sticker"
                                                SourceUri="{Binding BestSourceUri}" />
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <TextBlock
                                x:Name="StickerPanelStatusText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                Text="Loading stickers..."
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="PhotoOverlay"
            Grid.RowSpan="3"
            Background="#D9000000"
            IsHitTestVisible="True"
            Visibility="Collapsed">
            <Grid
                x:Name="PhotoOverlayBackground"
                Background="Transparent"
                Tapped="PhotoOverlayBackground_Tapped" />

            <Button
                x:Name="ClosePhotoOverlayButton"
                Width="44"
                Height="44"
                Margin="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#CC000000"
                BorderThickness="0"
                Canvas.ZIndex="20"
                Click="ClosePhotoOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse
                                Width="44"
                                Height="44"
                                Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="White"
                    Text="&#xE711;" />
            </Button>

            <TextBlock
                x:Name="PhotoOverlayCounter"
                Margin="0,27,18,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Canvas.ZIndex="20"
                FontSize="14"
                Foreground="#CCCCCC" />

            <Button
                x:Name="DownloadPhotoOverlayButton"
                Width="44"
                Height="44"
                Margin="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#CC000000"
                BorderThickness="0"
                Canvas.ZIndex="20"
                Click="DownloadPhotoOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse
                                Width="44"
                                Height="44"
                                Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="White"
                    Text="&#xE118;" />
            </Button>

            <FlipView
                x:Name="PhotoOverlayFlipView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <FlipView.ItemTemplate>
                    <DataTemplate>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            Loaded="PhotoOverlayScrollViewer_Loaded"
                            MaxZoomFactor="6"
                            MinZoomFactor="1"
                            SizeChanged="PhotoOverlayScrollViewer_SizeChanged"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled"
                            ZoomMode="Enabled">
                            <Grid Background="Transparent">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding}"
                                    Stretch="Uniform" />
                            </Grid>
                        </ScrollViewer>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <StackPanel
                x:Name="PhotoOverlayIndicatorPanel"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="20"
                Orientation="Horizontal" />
        </Grid>
    </Grid>
</Page>
