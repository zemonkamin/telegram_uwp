            Tapped="Header_Tapped">
            <Grid>
                <Grid
                    Canvas.ZIndex="1"
                    Margin="5,4,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Ellipse
                            Width="42"
                            Height="42"
                            Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                        <Ellipse Width="42" Height="42">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="HeaderAvatar" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            x:Name="HeaderInitials"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="HeaderTitle"
                            FontSize="17"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
