                                                AccentBrush="{Binding MediaControlAccentBrush}"
                                                AccentForegroundBrush="{Binding MediaControlAccentForegroundBrush}"
                                                HorizontalAlignment="Stretch"
                                                DurationSeconds="{Binding MediaDurationSeconds}"
                                                IsDownloading="{Binding IsMediaDownloading}"
                                                MediaKind="{Binding MediaKind}"
