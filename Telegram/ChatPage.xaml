<Page
    x:Class="Telegram.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Telegram.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Telegram"
    xmlns:messages="using:Telegram.Controls.Messages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="TelegramHeaderBorderBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="TelegramPanelBorderBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="TelegramInputBackgroundBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FFB3B3B3" />
                    <SolidColorBrush x:Key="TelegramSubtleTextBrush" Color="#FF9C9C9C" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="TelegramOverlayButtonBrush" Color="#BB050505" />
                    <SolidColorBrush x:Key="TelegramMediaPlaceholderBrush" Color="#FFA6A6A6" />
                    <SolidColorBrush x:Key="TelegramReplyBackgroundBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramAttachmentBackgroundBrush" Color="#FF151515" />
                    <SolidColorBrush x:Key="TelegramInlineKeyboardButtonBrush" Color="#D93C3C3C" />
                    <SolidColorBrush x:Key="TelegramInlineKeyboardButtonForegroundBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="TelegramHeaderBorderBrush" Color="#FFDADADA" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="TelegramPanelBorderBrush" Color="#FFDADADA" />
                    <SolidColorBrush x:Key="TelegramInputBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TelegramSubtleTextBrush" Color="#FF7A7A7A" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="TelegramOverlayButtonBrush" Color="#EEFFFFFF" />
                    <SolidColorBrush x:Key="TelegramMediaPlaceholderBrush" Color="#FFE7E7E7" />
                    <SolidColorBrush x:Key="TelegramReplyBackgroundBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="TelegramAttachmentBackgroundBrush" Color="#FFEFEFEF" />
                    <SolidColorBrush x:Key="TelegramInlineKeyboardButtonBrush" Color="#C76A6A6A" />
                    <SolidColorBrush x:Key="TelegramInlineKeyboardButtonForegroundBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TelegramBareButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TelegramFullWidthTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TelegramInlineKeyboardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource TelegramInlineKeyboardButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramInlineKeyboardButtonForegroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="InlineKeyboardButtonRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="InlineKeyboardButtonSurface"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.88"
                                                    Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="InlineKeyboardButtonSurface"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.68"
                                                    Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="InlineKeyboardButtonRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.45"
                                                    Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="InlineKeyboardButtonSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="0">
                                    <ContentPresenter
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChatComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0,14,4,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="Transparent">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    HorizontalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DateSeparatorTemplate">
                <Grid Padding="0,6,0,6" HorizontalAlignment="Stretch">
                    <Border
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                        Padding="12,4,12,4">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="{Binding DateText}"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ServiceMessageTemplate">
                <Grid Padding="0,6,0,6" HorizontalAlignment="Stretch">
                    <Border
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                        Padding="12,4,12,4">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="{Binding ServiceActionText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </DataTemplate>

            <local:DateSeparatorVisibilityConverter x:Key="DateSeparatorVisibilityConverter" />
            <local:UnreadSeparatorVisibilityConverter x:Key="UnreadSeparatorVisibilityConverter" />
            <local:ServiceMessageVisibilityConverter x:Key="ServiceMessageVisibilityConverter" />
            <local:NormalMessageVisibilityConverter x:Key="NormalMessageVisibilityConverter" />

            <!-- Message rows are split per kind so a plain text message does not have to
                 inflate the poll, file, photo, video, sticker, voice and music subtrees. -->
            <DataTemplate x:Key="MessageDateSeparatorTemplate">
                <Grid>
                            <!-- Date separator -->
                            <Grid
                                Padding="0,6,0,6"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Converter={StaticResource DateSeparatorVisibilityConverter}}">
                                <Border
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    Padding="12,4,12,4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiLight"
                                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                        Text="{Binding DateText}"
                                    TextAlignment="Center" />
                                </Border>
                            </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MessageUnreadSeparatorTemplate">
                <Grid>
                            <!-- Unread separator -->
                            <Grid
                                Padding="0,6,0,6"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Converter={StaticResource UnreadSeparatorVisibilityConverter}}">
                                <Border
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    Padding="12,4,12,4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiLight"
                                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                        Text="{Binding UnreadText}"
                                        TextAlignment="Center" />
                                </Border>
                            </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MessageServiceTemplate">
                <Grid>
                            <!-- Service message -->
                            <Grid
                                Padding="0,6,0,6"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Converter={StaticResource ServiceMessageVisibilityConverter}}">
                                <Border
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    Padding="12,4,12,4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiLight"
                                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                        Text="{Binding ServiceActionText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MessageTextTemplate">
                <Grid>
                            <!-- Normal message -->
                            <Grid
                                Padding="0,2,0,2"
                                Background="Transparent"
                                Holding="MessageRoot_Holding"
                                RightTapped="MessageRoot_RightTapped"
                                Tapped="MessageRoot_Tapped"
                                ManipulationMode="System,TranslateX"
                                ManipulationStarted="MessageRoot_ManipulationStarted"
                                ManipulationDelta="MessageRoot_ManipulationDelta"
                                ManipulationCompleted="MessageRoot_ManipulationCompleted"
                                Tag="{Binding}"
                                Visibility="{Binding Converter={StaticResource NormalMessageVisibilityConverter}}">
                            <Grid
                                Width="34"
                                Height="34"
                                Margin="7,1,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Tag="{Binding}"
                                Tapped="SenderProfile_Tapped"
                                Visibility="{Binding AvatarVisibility}">
                                <Ellipse
                                    Width="34"
                                    Height="34"
                                    Fill="{ThemeResource TelegramAvatarPlaceholderBrush}" />
                                <Ellipse Width="34" Height="34">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SenderAvatarImageSource}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding SenderInitials}"
                                    Visibility="{Binding SenderInitialsVisibility}" />
                            </Grid>

                            <Grid
                                MaxWidth="{Binding BubbleMaxWidth}"
                                Margin="{Binding BubbleMargin}"
                                HorizontalAlignment="{Binding BubbleAlignment}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    MinHeight="{Binding BubbleMinHeight}"
                                    MaxWidth="{Binding BubbleMaxWidth}"
                                    Padding="{Binding BubblePadding}"
                                    HorizontalAlignment="Left"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorderBrush}"
                                    BorderThickness="{Binding BubbleBorderThickness}"
                                    CornerRadius="0">
                                    <!-- Content is always row 0 and the time/state footer is always
                                         row 1 below it. Media loading can change the height later,
                                         but the footer can no longer overlap the photo or sticker. -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Width="{Binding BubbleStretchContentWidth}"
                                            Margin="{Binding BubbleContentMargin}"
                                            HorizontalAlignment="{Binding BubbleContentAlignment}">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFD05A5A"
                                                Tag="{Binding}"
                                                Tapped="SenderProfile_Tapped"
                                                Text="{Binding SenderName}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding SenderVisibility}" />

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,0,0,0"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Visibility="{Binding ForwardedVisibility}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{Binding MessageSubtleForeground}"
                                                    Text="{Binding ForwardedFrom}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Border>

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,1,0,2"
                                                Background="Transparent"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Tag="{Binding}"
                                                Tapped="ReplyPreview_Tapped"
                                                Visibility="{Binding ReplyToVisibility}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding MessageAccentBrush}"
                                                        MaxLines="1"
                                                        Text="{Binding ReplyToSenderDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="ReplyPreviewText"
                                                        DataContextChanged="LocalEmojiTextBlock_DataContextChanged"
                                                        FontSize="11"
                                                        Foreground="{Binding MessageSubtleForeground}"
                                                        Loaded="LocalEmojiTextBlock_Loaded"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>


                                            <TextBlock
                                                x:Name="MessageMarkdownText"
                                                Margin="{Binding CaptionMargin}"
                                                DataContextChanged="MessageMarkdownText_DataContextChanged"
                                                FontSize="16"
                                                Foreground="{Binding MessageForeground}"
                                                Loaded="MessageMarkdownText_Loaded"
                                                Tag="{Binding}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{Binding TextVisibility}" />

                                            <ItemsControl
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding Reactions}"
                                                Visibility="{Binding ReactionsVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ReactionWrapPanel ItemSpacing="6" LineSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Margin="0"
                                                            Padding="0"
                                                            Click="ReactionButton_Click"
                                                            Style="{StaticResource TelegramBareButtonStyle}">
                                                            <Border
                                                                MinWidth="54"
                                                                Height="32"
                                                                Padding="9,0,9,0"
                                                                Background="{Binding ChipBackground}"
                                                                CornerRadius="0">
                                                                <StackPanel
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CustomEmojiVisibility}">
                                                                        <controls:FfmpegStickerImageControl
                                                                            Canvas.Left="0"
                                                                            Canvas.Top="4"
                                                                            Width="22"
                                                                            Height="22"
                                                                            ImageStretch="Uniform"
                                                                            MediaKind="sticker"
                                                                            SourceUri="{Binding CustomEmojiUri}" />
                                                                    </Canvas>
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding StandardEmojiVisibility}">
                                                                        <TextBlock
                                                                            Canvas.Left="-1"
                                                                            Canvas.Top="4"
                                                                            Width="24"
                                                                            Height="24"
                                                                            FontFamily="ms-appx:///Assets/Emoji/AppleColorEmoji.ttc#Apple Color Emoji"
                                                                            FontSize="18"
                                                                            Text="{Binding Emoticon}"
                                                                            TextAlignment="Center" />
                                                                    </Canvas>
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CustomEmojiFallbackVisibility}">
                                                                        <TextBlock
                                                                            Canvas.Left="-1"
                                                                            Canvas.Top="4"
                                                                            Width="24"
                                                                            Height="24"
                                                                            FontSize="18"
                                                                            Text="{Binding DisplayText}"
                                                                            TextAlignment="Center" />
                                                                    </Canvas>
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="16"
                                                                        Foreground="{Binding ChipForeground}"
                                                                        Text="{Binding CountText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <controls:CommentsPreviewControl
                                                Margin="0,4,0,0"
                                                Tag="{Binding}"
                                                Tapped="CommentsPreview_Tapped"
                                                Visibility="{Binding CommentsPreviewVisibility}" />

                                        </StackPanel>

                                        <!-- Keep the time/state footer plain. Media messages must not
                                             draw a dark rounded pill behind the ticks or duration text. -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="{Binding FooterMargin}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Visibility="{Binding FooterVisibility}">
                                            <Image
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,4,0"
                                                Source="{Binding StateIconSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding OutgoingStateVisibility}" />
                                            <TextBlock
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                FontSize="11"
                                                Foreground="{Binding FooterForeground}"
                                                MaxLines="1"
                                                Text="{Binding FooterText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl
                                    Grid.Row="1"
                                    MinWidth="{Binding InlineKeyboardWidth}"
                                    MaxWidth="{Binding BubbleMaxWidth}"
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding InlineKeyboardRows}"
                                    Visibility="{Binding InlineKeyboardVisibility}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                ItemsSource="{Binding Buttons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:InlineKeyboardRowPanel ItemSpacing="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            MinHeight="44"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="BotInlineButton_Click"
                                                            Style="{StaticResource TelegramInlineKeyboardButtonStyle}"
                                                            Tag="{Binding}">
                                                            <TextBlock
                                                                MaxLines="2"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TelegramInlineKeyboardButtonForegroundBrush}"
                                                                Text="{Binding Text}"
                                                                TextAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MessageMediaTemplate">
                <Grid>
                            <!-- Normal message -->
                            <Grid
                                Padding="0,2,0,2"
                                Background="Transparent"
                                Holding="MessageRoot_Holding"
                                RightTapped="MessageRoot_RightTapped"
                                Tapped="MessageRoot_Tapped"
                                ManipulationMode="System,TranslateX"
                                ManipulationStarted="MessageRoot_ManipulationStarted"
                                ManipulationDelta="MessageRoot_ManipulationDelta"
                                ManipulationCompleted="MessageRoot_ManipulationCompleted"
                                Tag="{Binding}"
                                Visibility="{Binding Converter={StaticResource NormalMessageVisibilityConverter}}">
                            <Grid
                                Width="34"
                                Height="34"
                                Margin="7,1,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Tag="{Binding}"
                                Tapped="SenderProfile_Tapped"
                                Visibility="{Binding AvatarVisibility}">
                                <Ellipse
                                    Width="34"
                                    Height="34"
                                    Fill="{ThemeResource TelegramAvatarPlaceholderBrush}" />
                                <Ellipse Width="34" Height="34">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SenderAvatarImageSource}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding SenderInitials}"
                                    Visibility="{Binding SenderInitialsVisibility}" />
                            </Grid>

                            <Grid
                                MaxWidth="{Binding BubbleMaxWidth}"
                                Margin="{Binding BubbleMargin}"
                                HorizontalAlignment="{Binding BubbleAlignment}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    MinHeight="{Binding BubbleMinHeight}"
                                    MaxWidth="{Binding BubbleMaxWidth}"
                                    Padding="{Binding BubblePadding}"
                                    HorizontalAlignment="Left"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorderBrush}"
                                    BorderThickness="{Binding BubbleBorderThickness}"
                                    CornerRadius="0">
                                    <!-- Content is always row 0 and the time/state footer is always
                                         row 1 below it. Media loading can change the height later,
                                         but the footer can no longer overlap the photo or sticker. -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Width="{Binding BubbleStretchContentWidth}"
                                            Margin="{Binding BubbleContentMargin}"
                                            HorizontalAlignment="{Binding BubbleContentAlignment}">
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFD05A5A"
                                                Tag="{Binding}"
                                                Tapped="SenderProfile_Tapped"
                                                Text="{Binding SenderName}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding SenderVisibility}" />

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,0,0,0"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Visibility="{Binding ForwardedVisibility}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{Binding MessageSubtleForeground}"
                                                    Text="{Binding ForwardedFrom}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Border>

                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="6,1,0,2"
                                                Background="Transparent"
                                                BorderBrush="{Binding MessageAccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                Tag="{Binding}"
                                                Tapped="ReplyPreview_Tapped"
                                                Visibility="{Binding ReplyToVisibility}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding MessageAccentBrush}"
                                                        MaxLines="1"
                                                        Text="{Binding ReplyToSenderDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="ReplyPreviewText"
                                                        DataContextChanged="LocalEmojiTextBlock_DataContextChanged"
                                                        FontSize="11"
                                                        Foreground="{Binding MessageSubtleForeground}"
                                                        Loaded="LocalEmojiTextBlock_Loaded"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Swaps its child in code and keeps it when a recycled
                                                 row carries the same kind of message, so scrolling
                                                 through a run of photos inflates the subtree once
                                                 instead of once per row. -->
                                            <messages:MessageMediaHost
                                                AlbumTemplate="{StaticResource MediaAlbumTemplate}"
                                                FileTemplate="{StaticResource MediaFileTemplate}"
                                                GenericTemplate="{StaticResource MediaGenericTemplate}"
                                                GifTemplate="{StaticResource MediaGifTemplate}"
                                                LocationTemplate="{StaticResource MediaLocationTemplate}"
                                                MusicTemplate="{StaticResource MediaMusicTemplate}"
                                                PhotoTemplate="{StaticResource MediaPhotoTemplate}"
                                                PollTemplate="{StaticResource MediaPollTemplate}"
                                                RoundVideoTemplate="{StaticResource MediaRoundVideoTemplate}"
                                                StickerTemplate="{StaticResource MediaStickerTemplate}"
                                                TodoTemplate="{StaticResource MediaTodoTemplate}"
                                                VideoTemplate="{StaticResource MediaVideoTemplate}"
                                                VoiceTemplate="{StaticResource MediaVoiceTemplate}" />

