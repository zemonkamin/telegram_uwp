                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding MessageForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="13"
                                                            Foreground="{Binding MessageSubtleForeground}"
                                                            MaxLines="1"
                                                            Text="{Binding FileSubtitle}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
