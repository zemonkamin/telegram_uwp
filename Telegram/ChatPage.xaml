            <DataTemplate x:Key="MediaTodoTemplate">
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="0,2,0,2"
                                                Background="Transparent"
                                                Visibility="{Binding StructuredMediaVisibility}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding MessageForeground}"
                                                        Text="{Binding StructuredMediaTitle}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{Binding MessageSubtleForeground}"
                                                        Text="{Binding StructuredMediaSubtitle}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding StructuredMediaSubtitleVisibility}" />
                                                    <TextBlock
                                                        x:Name="StructuredMediaTextBlock"
                                                        Margin="0,6,0,0"
                                                        DataContextChanged="LocalEmojiTextBlock_DataContextChanged"
                                                        FontSize="13"
                                                        Foreground="{Binding MessageForeground}"
                                                        Loaded="LocalEmojiTextBlock_Loaded"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding StructuredMediaTextVisibility}" />
                                                    <ItemsControl
                                                        Margin="0,6,0,0"
                                                        ItemsSource="{Binding StructuredMediaItems}"
                                                        Visibility="{Binding StructuredMediaItemsVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button
                                                                    Margin="0,2,0,0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Click="StructuredMediaItem_Click"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Style="{StaticResource TelegramBareButtonStyle}">
                                                                    <Grid MinHeight="32" Background="Transparent">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="28" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="18"
                                                                            Foreground="{Binding AccentBrush}"
                                                                            Text="{Binding Glyph}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Foreground="{Binding Foreground}"
                                                                            Text="{Binding DisplayText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
            </DataTemplate>

            <DataTemplate x:Key="MediaFileTemplate">
                                            <Grid
                                                Width="{Binding MediaPlaceholderWidth}"
                                                MinHeight="54"
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Visibility="{Binding FileVisibility}">

                                                <Grid MinHeight="54">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button
                                                        Width="39"
                                                        Height="39"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Click="DownloadFileButton_Click"
                                                        IsEnabled="{Binding DownloadButtonEnabled}"
                                                        Style="{StaticResource TelegramBareButtonStyle}"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding FileIdleVisibility}">
                                                        <Grid Width="39" Height="39">
                                                            <Ellipse Fill="{Binding FileDownloadBackgroundBrush}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
