                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                </Grid>
            </DataTemplate>


            <!-- Media blocks are split per message kind. Kept together they made every
                 media row instantiate six MediaElements (two video players, the voice and
                 music players, the sticker control and the gif element) plus four
                 DispatcherTimers, all of which spin up a Media Foundation pipeline even
