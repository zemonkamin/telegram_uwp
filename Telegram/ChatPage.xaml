                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="last seen recently"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        x:Name="HeaderMoreButton"
                        Grid.Column="2"
                        Width="38"
                        Height="42"
                        Margin="0,4,0,3"
                        VerticalAlignment="Center"
                        Click="HeaderMoreButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            Opacity="0.75"
                            Text="&#xE712;" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border
            x:Name="PinnedMessageBar"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="10"
            Margin="0,58,0,0"
            VerticalAlignment="Top"
            Background="{ThemeResource TelegramHeaderBackgroundBrush}"
            BorderBrush="{ThemeResource TelegramHeaderBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid
                MinHeight="46"
                Padding="0,3,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="PinnedMessageIndicator"
                    Grid.Column="0"
                    Width="4"
                    Height="34"
                    Margin="0,4,0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="PinnedMessageIndicatorTrack"
                        Width="3"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        Opacity="0.22" />
                    <Border
                        x:Name="PinnedMessageIndicatorThumb"
                        Width="3"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    Margin="10,0,8,0"
                    Background="Transparent"
                    Tapped="PinnedMessageBar_Tapped">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PinnedMessageTitle"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                            Text="Pinned Message"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="PinnedMessageText"
                            Margin="0,-1,0,0"
                            FontSize="14"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            Text=""
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="ChatContentLayer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="0"
            Background="{ThemeResource TelegramPageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="ChatWallpaper"
                Grid.Row="0"
                Grid.RowSpan="2"
                Visibility="Collapsed" />

            <Rectangle
                x:Name="ChatWallpaperDim"
                Grid.Row="0"
                Grid.RowSpan="2"
                Fill="Black"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed" />

            <ListView
                x:Name="MessageList"
                Grid.Row="0"
                Grid.RowSpan="2"
                Padding="0,4,0,6"
                Background="Transparent"
                BorderThickness="0"
                IsItemClickEnabled="False"
                IsSwipeEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.IsHorizontalRailEnabled="False"
                Opacity="0"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False">
                <!-- No ItemTemplateSelector: containers are pooled per template by
                     MessageList_ChoosingItemContainer, which also assigns ContentTemplate. -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- CacheLength is in viewports of off-screen containers kept realized on
                             each side. The default of 1 means a short scroll back over rows you
                             just looked at still has to rebuild them; rows are cheap enough now
                             to afford a wider buffer. -->
                        <ItemsStackPanel
                            CacheLength="2.0"
                            ItemsUpdatingScrollMode="KeepItemsInView"
                            VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <TransitionCollection />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <Button
                x:Name="ScrollDownButton"
                Grid.Row="0"
                Grid.RowSpan="2"
                Canvas.ZIndex="30"
                Width="58"
                Height="58"
                Margin="0,0,15,68"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="ScrollDownButton_Click"
                Style="{StaticResource TelegramBareButtonStyle}"
                Visibility="Collapsed">
                <Grid Width="58" Height="58">
                    <Ellipse
                        Width="54"
                        Height="54"
                        Fill="{ThemeResource TelegramOverlayButtonBrush}"
                        Stroke="{ThemeResource TelegramPanelBorderBrush}"
                        StrokeThickness="2" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="30"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Text="&#xE74B;" />
                    <Border
                        x:Name="ScrollDownUnreadBadge"
                        Height="20"
                        MinWidth="20"
                        Margin="0,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ScrollDownUnreadText"
                            Margin="6,-1,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="White"
                            Text="" />
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <Border
            x:Name="ChatInputBar"
            Grid.Row="2"
            Canvas.ZIndex="10"
            Background="{ThemeResource TelegramPanelBackgroundBrush}"
            BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ChatInputGlass"
                    Grid.RowSpan="6"
                    Background="Transparent"
                    IsHitTestVisible="False" />

                <Border
                    x:Name="ReplyPanel"
                    Grid.Row="0"
                    Margin="10,8,10,0"
                    Padding="8"
                    Background="{ThemeResource TelegramReplyBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="3,0,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ReplyPreviewText"
                            FontSize="13"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Text="Reply"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="30"
                            Click="CancelReplyButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                Text="×" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="AttachmentPreviewScroll"
                    Grid.Row="1"
                    Height="88"
                    Margin="8,6,8,0"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="AttachmentPreviewList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="76"
                                    Height="76"
                                    Margin="0,0,8,0">
                                    <Border Background="{ThemeResource TelegramAttachmentBackgroundBrush}" CornerRadius="2">
                                        <Image
                                            Width="76"
                                            Height="76"
                                            Source="{Binding Preview}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <Border
                                        Height="20"
                                        VerticalAlignment="Bottom"
                                        Background="#99000000">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="White"
                                            Text="{Binding KindLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="0,-4,-4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="RemoveAttachmentButton_Click"
                                        Style="{StaticResource TelegramBareButtonStyle}">
                                        <Grid Width="28" Height="28">
                                            <Ellipse Fill="#CC000000" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="White"
                                                Text="&#xE711;" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid
                    x:Name="VideoNotePreviewPanel"
                    Grid.Row="2"
                    Height="224"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    Visibility="Collapsed">
                    <Grid
                        x:Name="VideoNotePreviewHost"
                        Width="196"
                        Height="196"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SizeChanged="VideoNotePreviewHost_SizeChanged">
                        <Ellipse Fill="{ThemeResource TelegramMediaPlaceholderBrush}" />
                        <CaptureElement
                            x:Name="VideoNoteCapturePreview"
                            Width="196"
                            Height="196"
                            Stretch="UniformToFill" />
                        <Path
                            x:Name="VideoNotePreviewMask"
                            Fill="{ThemeResource TelegramPanelBackgroundBrush}"
                            IsHitTestVisible="False"
                            Stretch="Fill" />
                        <Ellipse
                            IsHitTestVisible="False"
                            Stroke="#33000000"
                            StrokeThickness="1" />
                        <Border
                            x:Name="VideoNoteDurationBadge"
                            MinWidth="48"
                            Height="24"
                            Padding="8,0"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="VideoNoteDurationText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="0:00" />
                        </Border>
                    </Grid>
                </Grid>

                <Border
                    x:Name="InlineQueryPanel"
                    Grid.Row="3"
                    Height="116"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="InlineQueryActionButton"
                            Grid.Row="0"
                            Height="44"
                            Padding="14,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Click="InlineQueryActionButton_Click"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="InlineQueryActionButtonText"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                        </Button>

                        <Grid Grid.Row="1">
                            <GridView
                                x:Name="InlineQueryResultsGrid"
                                Margin="6,4,6,4"
                                IsItemClickEnabled="True"
                                ItemClick="InlineQueryResultsGrid_ItemClick"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.HorizontalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,4,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="128" Height="104">
                                            <Border
                                                Background="{ThemeResource TelegramMediaPlaceholderBrush}"
                                                CornerRadius="3" />
                                            <Image
                                                Source="{Binding PreviewImageSource}"
                                                Stretch="UniformToFill"
                                                Visibility="{Binding PreviewVisibility}" />
                                            <Grid Visibility="{Binding PlaceholderVisibility}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="34"
                                                    Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                                    Opacity="0.7"
                                                    Text="{Binding KindGlyph}" />
                                            </Grid>
                                            <Border
                                                Background="#66000000"
                                                Visibility="{Binding SendingVisibility}">
                                                <ProgressRing
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="{Binding IsSending}"
                                                    Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <ListView
                                x:Name="InlineQueryResultsList"
                                IsItemClickEnabled="True"
                                ItemClick="InlineQueryResultsGrid_ItemClick"
                                SelectionMode="None"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                Visibility="Collapsed">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="68" Padding="8,6,8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="52" Height="52">
                                                <Border
                                                    Background="{ThemeResource TelegramMediaPlaceholderBrush}"
                                                    CornerRadius="3" />
                                                <Image
                                                    Source="{Binding PreviewImageSource}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{Binding PreviewVisibility}" />
                                                <Grid Visibility="{Binding PlaceholderVisibility}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="24"
                                                        Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                                        Opacity="0.75"
                                                        Text="{Binding KindGlyph}" />
                                                </Grid>
                                                <Border
                                                    Background="#66000000"
                                                    Visibility="{Binding SendingVisibility}">
                                                    <ProgressRing
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsActive="{Binding IsSending}"
                                                        Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="10,0,4,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                                    Text="{Binding DisplayTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Height="34"
                                                    Margin="0,1,0,0"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                                    Text="{Binding DisplayDescription}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding DescriptionVisibility}" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                                    Text="{Binding DisplayUrl}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding UrlVisibility}" />
                                            </StackPanel>
                                            <Border
                                                Grid.ColumnSpan="2"
                                                VerticalAlignment="Bottom"
                                                BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Opacity="0.65" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ProgressRing
                                x:Name="InlineQueryProgress"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="False"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="InlineQueryEmptyText"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                IsHitTestVisible="False"
                                Text="No results"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="ComposerPanel"
                    Grid.Row="4"
                    MinHeight="56"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AttachColumn" Width="44" />
                        <ColumnDefinition x:Name="SendColumn" Width="56" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        MinHeight="56"
                        Margin="0,0,4,0"
                        VerticalAlignment="Stretch"
                        Background="Transparent">
                        <TextBox
                            x:Name="MessageText"
                            MinHeight="56"
                            MaxHeight="260"
                            Margin="42,0,0,0"
                            VerticalAlignment="Bottom"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            GotFocus="MessageText_GotFocus"
                            Style="{StaticResource ChatComposerTextBoxStyle}"
                            Tapped="MessageText_Tapped"
                            TextChanged="MessageText_TextChanged"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BotMenuButton"
                            Grid.Column="0"
                            Width="42"
                            Height="56"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="BotMenuButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}"
                            Visibility="Collapsed">
                            <Button.Transitions>
                                <TransitionCollection />
                            </Button.Transitions>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="22"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.82"
                                Text="&#xE712;" />
                        </Button>
                        <Button
                            x:Name="AttachButton"
                            Grid.Column="0"
                            Width="42"
                            Height="56"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="AttachButton_Click"
                            Style="{StaticResource TelegramBareButtonStyle}">
                            <Button.Transitions>
                                <TransitionCollection />
                            </Button.Transitions>
                            <TextBlock
                                x:Name="AttachIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.6"
                                Text="&#xE723;" />
                        </Button>
                        <TextBlock
                            x:Name="MessageWatermark"
                            Margin="48,0,0,18"
                            VerticalAlignment="Bottom"
                            FontSize="16"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramSubtleTextBrush}"
                            IsHitTestVisible="False"
                            Text="Type a message" />
                        <TextBlock
                            x:Name="VoiceCancelHint"
                            Margin="42,0,0,18"
                            VerticalAlignment="Bottom"
                            FontSize="16"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            IsHitTestVisible="False"
                            Text="&lt; Cancel"
                            Visibility="Collapsed" />
                    </Grid>

                    <Button
                        x:Name="EmojiButton"
                        Grid.Column="1"
                        Width="42"
                        Height="56"
                        Margin="2,0,0,0"
                        VerticalAlignment="Bottom"
                        Click="EmojiButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <Button.Transitions>
                            <TransitionCollection />
                        </Button.Transitions>
                        <TextBlock
                            x:Name="EmojiButtonIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            Opacity="0.6"
                            Text="&#xE76E;" />
                    </Button>

                    <local:ComposerSendButton
                        x:Name="SendButton"
                        Grid.Column="2"
                        Width="56"
                        Height="56"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Invoked="SendButton_Click"
                        Style="{StaticResource TelegramBareButtonStyle}">
                        <Button.Transitions>
                            <TransitionCollection />
                        </Button.Transitions>
                        <Grid Width="56" Height="56">
                            <Border
                                x:Name="SendButtonAccentBackground"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="SendIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                Opacity="0.6"
                                Text="&#xE720;" />
                        </Grid>
                    </local:ComposerSendButton>
                </Grid>

                <Grid
                    x:Name="ReadOnlyPanel"
                    Grid.Row="4"
                    Height="56"
                    Margin="0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ReadOnlyText"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TelegramSubtleTextBrush}"
                        Text="Sending messages is not available in this chat."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="ToggleNotificationsButton"
                        Grid.Column="1"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="ToggleNotificationsButton_Click"
                        Content="Turn off notifications"
                        FontSize="15"
                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                        Style="{StaticResource TelegramFullWidthTextButtonStyle}" />
                </Grid>

                <Border
                    x:Name="BotReplyKeyboardPanel"
                    Grid.Row="5"
                    MaxHeight="240"
                    Padding="8,6,8,8"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                        <ItemsControl x:Name="BotReplyKeyboardRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding Buttons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    MinWidth="92"
                                                    MinHeight="40"
                                                    MaxWidth="220"
                                                    Margin="2,0"
                                                    Padding="10,5"
                                                    HorizontalContentAlignment="Center"
                                                    Click="BotReplyKeyboardButton_Click"
                                                    Content="{Binding Text}"
                                                    Style="{StaticResource TelegramFullWidthTextButtonStyle}"
                                                    Tag="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border
                    x:Name="EmojiKeyboardPanel"
                    Grid.Row="5"
                    Height="260"
                    Background="{ThemeResource TelegramPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TelegramPanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="StickerSetTabsList"
                            Grid.Row="0"
                            Margin="4,0"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionChanged="StickerSetTabsList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        MaxWidth="116"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                        Text="{Binding DisplayTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="1">
                            <GridView
                                x:Name="StickerItemsControl"
                                Width="320"
                                MaxWidth="320"
                                Margin="0,4,0,8"
                                HorizontalAlignment="Center"
                                IsItemClickEnabled="False"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.IsVerticalRailEnabled="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Width" Value="76" />
                                        <Setter Property="Height" Value="76" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            HorizontalAlignment="Left"
                                            ItemHeight="76"
                                            ItemWidth="76"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="76"
                                            Height="76"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Click="StickerItem_Click"
                                            Tag="{Binding}">
                                            <controls:FfmpegStickerImageControl
                                                Width="64"
                                                Height="64"
                                                ImageStretch="Uniform"
                                                MediaKind="sticker"
                                                SourceUri="{Binding BestSourceUri}" />
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <TextBlock
                                x:Name="StickerPanelStatusText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TelegramSubtleTextBrush}"
                                Text="Loading stickers..."
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="PhotoOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="5000"
            Background="#D9000000"
            IsHitTestVisible="True"
            Visibility="Collapsed">
            <Grid
                x:Name="PhotoOverlayBackground"
                Background="Transparent"
                Tapped="PhotoOverlayBackground_Tapped" />

            <Button
                x:Name="ClosePhotoOverlayButton"
                Width="44"
                Height="44"
                Margin="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#CC000000"
                BorderThickness="0"
                Canvas.ZIndex="20"
                Click="ClosePhotoOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse
                                Width="44"
                                Height="44"
                                Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="White"
                    Text="&#xE711;" />
            </Button>

            <TextBlock
                x:Name="PhotoOverlayCounter"
                Margin="0,27,18,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Canvas.ZIndex="20"
                FontSize="14"
                Foreground="#CCCCCC" />

            <Button
                x:Name="DownloadPhotoOverlayButton"
                Width="44"
                Height="44"
                Margin="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#CC000000"
                BorderThickness="0"
                Canvas.ZIndex="20"
                Click="DownloadPhotoOverlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse
                                Width="44"
                                Height="44"
                                Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="White"
                    Text="&#xE118;" />
            </Button>

            <FlipView
                x:Name="PhotoOverlayFlipView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <FlipView.ItemTemplate>
                    <DataTemplate>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            Loaded="PhotoOverlayScrollViewer_Loaded"
                            MaxZoomFactor="6"
                            MinZoomFactor="1"
                            SizeChanged="PhotoOverlayScrollViewer_SizeChanged"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled"
                            ZoomMode="Enabled">
                            <Grid Background="Transparent">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding}"
                                    Stretch="Uniform" />
                            </Grid>
                        </ScrollViewer>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <StackPanel
                x:Name="PhotoOverlayIndicatorPanel"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="20"
                Orientation="Horizontal" />
        </Grid>
    </Grid>
</Page>
