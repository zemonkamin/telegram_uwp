                                                            Stroke="White"
                                                            StrokeThickness="4" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="22"
                                                            Foreground="White"
                                                            Text="&#xE711;" />
                                                    </Grid>
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MediaDownloadPlaceholderIconVisibility}">
                                                        <TextBlock
                                                            Margin="0,0,0,5"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="26"
                                                            Foreground="White"
                                                            Text="&#xE118;" />
                                                        <TextBlock
                                                            MaxWidth="{Binding MediaDownloadTextWidth}"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="{Binding DownloadButtonText}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

