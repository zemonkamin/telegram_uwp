                                                Foreground="{Binding MessageForeground}"
                                                Loaded="MessageMarkdownText_Loaded"
                                                Tag="{Binding}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{Binding TextVisibility}" />

                                            <ItemsControl
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding Reactions}"
                                                Visibility="{Binding ReactionsVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ReactionWrapPanel ItemSpacing="6" LineSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Margin="0"
                                                            Padding="0"
                                                            Click="ReactionButton_Click"
                                                            Style="{StaticResource TelegramBareButtonStyle}">
                                                            <Border
                                                                MinWidth="54"
                                                                Height="32"
                                                                Padding="9,0,9,0"
                                                                Background="{Binding ChipBackground}"
                                                                CornerRadius="0">
                                                                <StackPanel
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CustomEmojiVisibility}">
                                                                        <controls:FfmpegStickerImageControl
                                                                            Canvas.Left="0"
                                                                            Canvas.Top="4"
                                                                            Width="22"
                                                                            Height="22"
                                                                            ImageStretch="Uniform"
                                                                            MediaKind="sticker"
                                                                            SourceUri="{Binding CustomEmojiUri}" />
                                                                    </Canvas>
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding StandardEmojiVisibility}">
                                                                        <TextBlock
                                                                            Canvas.Left="-1"
                                                                            Canvas.Top="4"
                                                                            Width="24"
                                                                            Height="24"
                                                                            FontFamily="ms-appx:///Assets/Emoji/AppleColorEmoji.ttc#Apple Color Emoji"
                                                                            FontSize="18"
                                                                            Text="{Binding Emoticon}"
                                                                            TextAlignment="Center" />
                                                                    </Canvas>
                                                                    <Canvas
                                                                        Width="22"
                                                                        Height="24"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CustomEmojiFallbackVisibility}">
                                                                        <TextBlock
                                                                            Canvas.Left="-1"
                                                                            Canvas.Top="4"
                                                                            Width="24"
                                                                            Height="24"
                                                                            FontSize="18"
                                                                            Text="{Binding DisplayText}"
                                                                            TextAlignment="Center" />
                                                                    </Canvas>
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="16"
                                                                        Foreground="{Binding ChipForeground}"
                                                                        Text="{Binding CountText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <controls:CommentsPreviewControl
                                                Margin="0,4,0,0"
                                                Tag="{Binding}"
                                                Tapped="CommentsPreview_Tapped"
                                                Visibility="{Binding CommentsPreviewVisibility}" />

                                        </StackPanel>

                                        <!-- Keep the time/state footer plain. Media messages must not
                                             draw a dark rounded pill behind the ticks or duration text. -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="{Binding FooterMargin}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Visibility="{Binding FooterVisibility}">
                                            <Image
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,4,0"
                                                Source="{Binding StateIconSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding OutgoingStateVisibility}" />
                                            <TextBlock
                                                MaxWidth="{Binding BubbleMaxWidth}"
                                                FontSize="11"
                                                Foreground="{Binding FooterForeground}"
                                                MaxLines="1"
                                                Text="{Binding FooterText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl
                                    Grid.Row="1"
                                    MinWidth="{Binding InlineKeyboardWidth}"
                                    MaxWidth="{Binding BubbleMaxWidth}"
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding InlineKeyboardRows}"
                                    Visibility="{Binding InlineKeyboardVisibility}">
