        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{ThemeResource TelegramPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar
            x:Name="TopLoadingBar"
            Grid.RowSpan="3"
            Height="3"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <Border
            x:Name="ChatTopChromeGlass"
            Grid.Row="0"
            Grid.RowSpan="3"
            Height="58"
            VerticalAlignment="Top"
            Canvas.ZIndex="9"
            Background="Transparent"
            IsHitTestVisible="False" />

