                                                    <Border Background="#66000000" />
                                                    <Grid
                                                        Width="64"
                                                        Height="64"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MediaDownloadProgressCircleVisibility}">
                                                        <Ellipse Fill="#7F000000" />
                                                        <local:DownloadProgressPieSlice
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsIndeterminate="{Binding MediaDownloadProgressIndeterminate}"
                                                            Progress="{Binding MediaDownloadProgressValue}"
                                                            Radius="28"
                                                            Stroke="White"
                                                            StrokeThickness="4" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="22"
                                                            Foreground="White"
                                                            Text="&#xE711;" />
                                                    </Grid>
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MediaDownloadPlaceholderIconVisibility}">
                                                        <TextBlock
                                                            Margin="0,0,0,5"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="26"
                                                            Foreground="White"
                                                            Text="&#xE118;" />
                                                        <TextBlock
                                                            MaxWidth="{Binding MediaDownloadTextWidth}"
