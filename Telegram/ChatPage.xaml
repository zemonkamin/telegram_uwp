                                                            Padding="8,4"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="BotInlineButton_Click"
                                                            Style="{StaticResource TelegramInlineKeyboardButtonStyle}"
                                                            Tag="{Binding}">
                                                            <TextBlock
                                                                MaxLines="2"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TelegramInlineKeyboardButtonForegroundBrush}"
