<Page
    x:Class="Telegram.AdaptiveShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Frame x:Name="NavigationFrame" Grid.Column="0" />

        <Border
            x:Name="DetailPane"
            Grid.Column="1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <Grid>
                <Frame x:Name="DetailFrame" Visibility="Collapsed" />

                <Grid
                    x:Name="EmptyDetailPanel"
                    Padding="24"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon
                            Margin="0,0,0,14"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="42"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            FontSize="20"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                            Text="Select a chat to start messaging"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
