<Page
    x:Class="Telegram.Chats"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Telegram"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FF1B1B1B" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FF1D1D1D" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF8D8D8D" />
                    <SolidColorBrush x:Key="TelegramTimeTextBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FF2E2E2E" />
                    <SolidColorBrush x:Key="TelegramAvatarTextBrush" Color="#FFEDEDED" />
                    <SolidColorBrush x:Key="TelegramSearchBoxBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramSearchBoxTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TelegramCommandBarOverflowBrush" Color="#FF1D1D1D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TelegramPageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramHeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="TelegramPanelBackgroundBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="TelegramPrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramSecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TelegramTimeTextBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="TelegramAvatarPlaceholderBrush" Color="#FFE1E1E1" />
                    <SolidColorBrush x:Key="TelegramAvatarTextBrush" Color="#FF333333" />
                    <SolidColorBrush x:Key="TelegramSearchBoxBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TelegramSearchBoxTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="TelegramCommandBarOverflowBrush" Color="#FFF7F7F7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:ArchiveEntryVisibilityConverter x:Key="ArchiveEntryVisibilityConverter" />
            <local:NonArchiveEntryVisibilityConverter x:Key="NonArchiveEntryVisibilityConverter" />

            <Style x:Key="ChatsCommandBarOverflowPresenterStyle" TargetType="CommandBarOverflowPresenter">
                <Setter Property="Background" Value="{ThemeResource TelegramCommandBarOverflowBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TelegramPrimaryTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <ControlTemplate x:Key="ChatsSecondaryCommandButtonTemplate" TargetType="AppBarButton">
                <Grid
                    Width="{TemplateBinding Width}"
                    MinHeight="44"
                    Padding="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}"
                        Foreground="{TemplateBinding Foreground}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="15"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Label}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ChatsAccountCommandButtonTemplate" TargetType="AppBarButton">
                <Grid
                    Width="{TemplateBinding Width}"
                    MinHeight="44"
                    Padding="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Border
                            Width="28"
                            Height="28"
                            Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                            CornerRadius="14">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="White"
                                Glyph="&#xE77B;" />
                        </Border>
                        <Ellipse Width="28" Height="28">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="15"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Label}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </ControlTemplate>

            <DataTemplate x:Key="SearchChatItemTemplate">
                <Grid
                    MinHeight="64"
                    Padding="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource TelegramPageBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <Grid
                            Width="46"
                            Height="46"
                            Visibility="{Binding IsArchiveEntry, Converter={StaticResource NonArchiveEntryVisibilityConverter}}">
                            <Border
                                Width="46"
                                Height="46"
                                Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                CornerRadius="23">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                    Text="{Binding IconText}" />
                            </Border>
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <Grid
                            Width="46"
                            Height="46"
                            Visibility="{Binding IsArchiveEntry, Converter={StaticResource ArchiveEntryVisibilityConverter}}">
                            <Border
                                Width="46"
                                Height="46"
                                Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                CornerRadius="23" />
                            <BitmapIcon
                                Width="22"
                                Height="22"
                                Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                HorizontalAlignment="Center"
                                UriSource="ms-appx:///Assets/archive.png"
                                VerticalAlignment="Center"
                                />
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="4,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            MaxLines="1"
                            Text="{Binding DisplayTitle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="ChatLastMessageText"
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Stretch"
                            DataContextChanged="ChatLastMessageText_DataContextChanged"
                            FontSize="13"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Loaded="ChatLastMessageText_Loaded"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>

                    <Grid
                        Grid.Column="2"
                        Width="76"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{ThemeResource TelegramTimeTextBrush}"
                            MaxLines="1"
                            Text="{Binding LastTimeText}"
                            TextAlignment="Right"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Row="1"
                            Height="18"
                            MinWidth="18"
                            Padding="5,0"
                            HorizontalAlignment="Right"
                            Background="{Binding UnreadBadgeBrush}"
                            CornerRadius="9"
                            Visibility="{Binding UnreadBadgeVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="White"
                                Text="{Binding UnreadBadge}" />
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>

            <Style x:Key="ChatListItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Background="Transparent">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ChatRowTemplate">
                <Grid
                    MinHeight="64"
                    Padding="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Holding="ChatItem_Holding"
                    RightTapped="ChatItem_RightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <Grid
                            Width="46"
                            Height="46"
                            Visibility="{Binding IsArchiveEntry, Converter={StaticResource NonArchiveEntryVisibilityConverter}}">
                            <Border
                                Width="46"
                                Height="46"
                                Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                CornerRadius="23">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                    Text="{Binding IconText}" />
                            </Border>
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <Grid
                            Width="46"
                            Height="46"
                            Visibility="{Binding IsArchiveEntry, Converter={StaticResource ArchiveEntryVisibilityConverter}}">
                            <Border
                                Width="46"
                                Height="46"
                                Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                CornerRadius="23" />
                            <BitmapIcon
                                Width="22"
                                Height="22"
                                Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                HorizontalAlignment="Center"
                                UriSource="ms-appx:///Assets/archive.png"
                                VerticalAlignment="Center"
                                />
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="4,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiLight"
                            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                            MaxLines="1"
                            Text="{Binding DisplayTitle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <TextBlock
                            x:Name="ChatLastMessageText"
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Stretch"
                            DataContextChanged="ChatLastMessageText_DataContextChanged"
                            FontSize="13"
                            Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                            Loaded="ChatLastMessageText_Loaded"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>

                    <Grid
                        Grid.Column="2"
                        Width="76"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <FontIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Foreground="{ThemeResource TelegramTimeTextBrush}"
                                Glyph="&#xE718;"
                                Visibility="{Binding PinnedIconVisibility}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TelegramTimeTextBrush}"
                                MaxLines="1"
                                Text="{Binding LastTimeText}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Height="18"
                            MinWidth="18"
                            Padding="5,0"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            CornerRadius="9"
                            Visibility="{Binding UnreadBadgeVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="White"
                                Text="{Binding UnreadBadge}" />
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource TelegramPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="ChatsTopBar"
            Grid.Row="0"
            Canvas.ZIndex="10"
            Padding="14,-8,0,0"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Border
                x:Name="ChatsTopBarGlass"
                Margin="-14,8,0,0"
                Background="Transparent"
                IsHitTestVisible="False" />
            <ListView
                x:Name="FolderList"
                Height="56"
                Canvas.ZIndex="1"
                Background="Transparent"
                BorderThickness="0"
                IsSwipeEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionChanged="FolderList_SelectionChanged"
                SelectionMode="Single">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemSelectedBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemPointerOverBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemPressedBackgroundThemeBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <TransitionCollection />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid Background="Transparent">
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Height="56"
                            Padding="0,0,24,0"
                            VerticalAlignment="Center"
                            Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                FontSize="24"
                                FontWeight="Light"
                                Foreground="{Binding HeaderForeground}"
                                Text="{Binding HeaderTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Row="1"
                                Height="3"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Visibility="{Binding SelectedUnderlineVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <FlipView
            x:Name="FolderFlip"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="0"
            Background="{ThemeResource TelegramPageBackgroundBrush}"
            SelectionChanged="FolderFlip_SelectionChanged">
            <FlipView.ItemContainerStyle>
                <Style TargetType="FlipViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </FlipView.ItemContainerStyle>
            <FlipView.ItemTemplate>
                <DataTemplate>
                    <ListView
                        Padding="0,2,0,2"
                        Background="{ThemeResource TelegramPageBackgroundBrush}"
                        BorderThickness="0"
                        ContainerContentChanging="ChatList_ContainerContentChanging"
                        DataFetchSize="2"
                        IncrementalLoadingThreshold="2"
                        IncrementalLoadingTrigger="Edge"
                        IsItemClickEnabled="True"
                        ItemsSource="{Binding VisibleChats}"
                        ItemClick="ChatList_ItemClick"
                        Loaded="ChatList_Loaded"
                        SelectionMode="None"
                        SizeChanged="ChatList_SizeChanged">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectedBackgroundThemeBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemPointerOverBackgroundThemeBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemPressedBackgroundThemeBrush" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Transitions">
                        <Setter.Value>
                            <TransitionCollection />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid Background="Transparent">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        MinHeight="64"
                        Padding="10,5,10,5"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Holding="ChatItem_Holding"
                        RightTapped="ChatItem_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Width="46"
                            Height="46"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Grid
                                Width="46"
                                Height="46"
                                Visibility="{Binding IsArchiveEntry, Converter={StaticResource NonArchiveEntryVisibilityConverter}}">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                    CornerRadius="23">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                        Text="{Binding IconText}" />
                                </Border>
                                <Ellipse Width="46" Height="46">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <Grid
                                Width="46"
                                Height="46"
                                Visibility="{Binding IsArchiveEntry, Converter={StaticResource ArchiveEntryVisibilityConverter}}">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Background="{ThemeResource TelegramAvatarPlaceholderBrush}"
                                    CornerRadius="23" />
                                <BitmapIcon
                                    Width="22"
                                    Height="22"
                                    Foreground="{ThemeResource TelegramAvatarTextBrush}"
                                    HorizontalAlignment="Center"
                                    UriSource="ms-appx:///Assets/archive.png"
                                    VerticalAlignment="Center"
                                    />
                            </Grid>
                        </Grid>

                        <Grid
                            Grid.Column="1"
                            Margin="4,0,10,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                FontSize="18"
                                FontWeight="SemiLight"
                                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                                MaxLines="1"
                                Text="{Binding DisplayTitle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />

                            <TextBlock
                                x:Name="ChatLastMessageText"
                                Grid.Row="1"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Stretch"
                                DataContextChanged="ChatLastMessageText_DataContextChanged"
                                FontSize="13"
                                Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                                Loaded="ChatLastMessageText_Loaded"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>

                        <Grid
                            Grid.Column="2"
                            Width="76"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Foreground="{ThemeResource TelegramTimeTextBrush}"
                                    Glyph="&#xE718;"
                                    Visibility="{Binding PinnedIconVisibility}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TelegramTimeTextBrush}"
                                    MaxLines="1"
                                    Text="{Binding LastTimeText}"
                                    TextAlignment="Right"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                Grid.Row="1"
                                Height="18"
                                MinWidth="18"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                Background="{Binding UnreadBadgeBrush}"
                                CornerRadius="9"
                                Visibility="{Binding UnreadBadgeVisibility}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="White"
                                    Text="{Binding UnreadBadge}" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
                    </ListView>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <Border
            x:Name="BottomMenuAppBarGlass"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="9"
            VerticalAlignment="Bottom"
            Background="Transparent"
            IsHitTestVisible="False" />

        <CommandBar
            x:Name="BottomMenuAppBar"
            Grid.Row="2"
            Canvas.ZIndex="10"
            HorizontalAlignment="Stretch"
            Closed="BottomMenuAppBar_Closed"
            ClosedDisplayMode="Compact"
            Closing="BottomMenuAppBar_Closing"
            CommandBarOverflowPresenterStyle="{StaticResource ChatsCommandBarOverflowPresenterStyle}"
            Foreground="{ThemeResource TelegramPrimaryTextBrush}"
            Loaded="BottomMenuAppBar_Loaded"
            Opened="BottomMenuAppBar_Opened"
            Opening="BottomMenuAppBar_Opening"
            SizeChanged="BottomMenuAppBar_SizeChanged">

            <CommandBar.PrimaryCommands>
                <AppBarButton
                    x:Name="NewMessageButton"
                    IsEnabled="False"
                    Label="New message">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="SearchButton"
                    Click="SearchButton_Click"
                    Label="Search">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="ContactsButton"
                    Click="ContactsButton_Click"
                    Label="Contacts">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE716;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Label="Refresh">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Name="SavedMessagesButton"
                    Width="{Binding ActualWidth, ElementName=BottomMenuAppBar}"
                    HorizontalAlignment="Stretch"
                    Click="SavedMessagesButton_Click"
                    Label="Saved messages"
                    Template="{StaticResource ChatsSecondaryCommandButtonTemplate}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="SettingsMenuButton"
                    Width="{Binding ActualWidth, ElementName=BottomMenuAppBar}"
                    HorizontalAlignment="Stretch"
                    Click="SettingsMenuButton_Click"
                    Label="Settings"
                    Template="{StaticResource ChatsSecondaryCommandButtonTemplate}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="AccountMenuButton"
                    Width="{Binding ActualWidth, ElementName=BottomMenuAppBar}"
                    HorizontalAlignment="Stretch"
                    Click="AccountMenuButton_Click"
                    Label="Account"
                    Template="{StaticResource ChatsAccountCommandButtonTemplate}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel
            Grid.Row="2"
            Background="{ThemeResource TelegramPageBackgroundBrush}"
            Visibility="Collapsed">
            <Button
                x:Name="LoadMoreButton"
                Margin="10,6,10,0"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource TelegramPanelBackgroundBrush}"
                BorderBrush="{ThemeResource TelegramSecondaryTextBrush}"
                Click="LoadMoreButton_Click"
                Content=""
                Foreground="{ThemeResource TelegramPrimaryTextBrush}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Padding="12,6,12,8"
                FontSize="14"
                Foreground="{ThemeResource TelegramSecondaryTextBrush}"
                Text=""
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <ProgressBar
            x:Name="TopLoadingBar"
            Grid.RowSpan="3"
            Height="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Canvas.ZIndex="1000"
            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
            IsHitTestVisible="False"
            IsIndeterminate="False"
            Visibility="Collapsed" />

    </Grid>
</Page>
