<Page
    x:Class="Telegram.TopicListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Telegram.Controls">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF1B1B1B" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF8D8D8D" />
                    <SolidColorBrush x:Key="TimeTextBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#FF2E2E2E" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#FFEDEDED" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF666666" />
                    <SolidColorBrush x:Key="TimeTextBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#FFE1E1E1" />
                    <SolidColorBrush x:Key="AvatarTextBrush" Color="#FF333333" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TopicCommandBarOverflowPresenterStyle" TargetType="CommandBarOverflowPresenter">
                <Setter Property="Background" Value="{ThemeResource HeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar
            x:Name="TopLoadingBar"
            Grid.RowSpan="3"
            Canvas.ZIndex="100"
            Height="3"
            VerticalAlignment="Top"
            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <Grid
            Grid.Row="0"
            Padding="12,4,12,4"
            Background="{ThemeResource HeaderBackgroundBrush}">
            <StackPanel
                VerticalAlignment="Center"
                Tapped="Header_Tapped">
                <TextBlock
                    x:Name="HeaderTitle"
                    FontSize="20"
                    FontWeight="SemiLight"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    MaxLines="1"
                    Text="Topics"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="HeaderSubtitle"
                    Margin="0,1,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    MaxLines="1"
                    Text="forum"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="TopicList"
            Grid.Row="1"
            Padding="0,4,0,12"
            Background="{ThemeResource PageBackgroundBrush}"
            BorderThickness="0"
            IsItemClickEnabled="True"
            ItemClick="TopicList_ItemClick"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="64" Padding="10,5,10,5" Background="{ThemeResource PageBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="46" Height="46" Background="{Binding TopicIconBrush}" CornerRadius="23">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="{Binding IconText}" Visibility="{Binding TopicIconTextVisibility}" />
                                    <controls:FfmpegStickerImageControl Width="32"
                                                                        Height="32"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        SourceUri="{Binding TopicIconUri}"
                                                                        MediaKind="sticker"
                                                                        Visibility="{Binding TopicCustomIconVisibility}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiLight" Foreground="{ThemeResource PrimaryTextBrush}" MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" MaxLines="1" Text="{Binding DisplayLastMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TimeTextBrush}" MaxLines="1" Text="{Binding LastTimeText}" TextTrimming="CharacterEllipsis" />
                            <Border Margin="0,5,0,0" MinWidth="20" Height="20" HorizontalAlignment="Right" Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="10" Visibility="{Binding UnreadBadgeVisibility}">
                                <TextBlock Margin="6,0,6,1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White" Text="{Binding UnreadBadge}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="12,12,12,0"
            FontSize="14"
            Foreground="{ThemeResource SecondaryTextBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <CommandBar
            x:Name="BottomMenuAppBar"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            ClosedDisplayMode="Compact"
            CommandBarOverflowPresenterStyle="{StaticResource TopicCommandBarOverflowPresenterStyle}"
            Foreground="{ThemeResource PrimaryTextBrush}">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Label="Refresh">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Grid>
</Page>
