        private static int SafeOffset(long offset)
        {
            if (offset <= 0) return 0;
            if (offset > int.MaxValue) return int.MaxValue;
            return (int)offset;
        }

        private async Task<T> RunTdLibAsync<T>(Func<Task<T>> action)
        {
            await _tdLibOperationGate.WaitAsync();
            try
            {
                return await action();
            }
            finally
            {
                _tdLibOperationGate.Release();
            }
        }

