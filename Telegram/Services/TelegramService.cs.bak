        public async Task SendNotificationReplyAsync(string peerType, long peerId, long accessHash, bool canSendMessages, string text)
        {
            if (string.IsNullOrWhiteSpace(peerType) || peerId == 0 || string.IsNullOrWhiteSpace(text))
                return;

            var chat = new ChatViewModel
            {
                PeerType = peerType,
                PeerId = peerId,
                PeerKey = peerType + ":" + peerId.ToString(),
                AccessHash = accessHash,
                CanSendMessages = canSendMessages
            };

            await _client.SendTextMessageAsync(chat, text);
        }

