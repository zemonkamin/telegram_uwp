        public async Task<Tuple<List<ChatViewModel>, bool>> GetChatsPageAsync(int folderId, int offset, int limit, bool refresh, CancellationToken cancellationToken)
        {
            if (cancellationToken.IsCancellationRequested)
                return Tuple.Create(new List<ChatViewModel>(), false);

            var page = await RunTdLibAsync(() => _client.GetDialogsPageAsync(folderId, offset, limit, refresh));
            if (cancellationToken.IsCancellationRequested)
                return Tuple.Create(new List<ChatViewModel>(), false);

            if (page == null || page.Item1 == null)
                return Tuple.Create(new List<ChatViewModel>(), false);
            return page;
        }

