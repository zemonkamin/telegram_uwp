        private static string BuildPhoneCodeMessage(PhoneCodeResponse sent)
        {
            if (sent == null) return "Code sent. Enter the code from Telegram.";

            var target = sent.CodeType;
            if (string.IsNullOrEmpty(target))
                target = "Telegram";

            var message = "Code sent via " + target + ". Enter it below.";
            if (sent.Length > 0)
                message += " Code length: " + sent.Length + ".";
            if (sent.Timeout > 0)
                message += " A repeat request is usually available in " + sent.Timeout + " sec.";
            return message;
        }

        private static ChatViewModel FindSameChat(List<ChatViewModel> dialogs, ChatViewModel chat)
        {
            if (dialogs == null || chat == null) return null;

            var targetKey = chat.PeerKey;
            for (var i = 0; i < dialogs.Count; i++)
            {
                var item = dialogs[i];
                if (item == null) continue;

                if (!string.IsNullOrEmpty(targetKey) && item.PeerKey == targetKey)
                    return item;

                if (item.PeerId == chat.PeerId && item.PeerType == chat.PeerType)
                    return item;
            }

            return null;
        }

        private static void CopyChatInfo(ChatViewModel source, ChatViewModel target)
        {
            if (source == null || target == null) return;

            target.PeerId = source.PeerId;
            target.PeerType = source.PeerType;
            target.PeerKey = source.PeerKey;
            target.AccessHash = source.AccessHash;
            target.Title = source.Title;
            target.LastMessage = source.LastMessage;
            target.LastMessageDate = source.LastMessageDate;
            target.LastMessageIsOutgoing = source.LastMessageIsOutgoing;
            target.UnreadCount = source.UnreadCount;
            target.TopMessageId = source.TopMessageId;
            target.ReadOutboxMaxId = source.ReadOutboxMaxId;
            target.FolderId = source.FolderId;
            target.IsMuted = source.IsMuted;
            target.IsPinned = source.IsPinned;
            target.PinnedMessageId = source.PinnedMessageId;
            target.PinnedMessagePreview = source.PinnedMessagePreview;
            target.PinnedMessageIds = source.PinnedMessageIds == null ? null : new List<int>(source.PinnedMessageIds);
            target.CurrentPinnedMessageIndex = source.CurrentPinnedMessageIndex;
            target.IsContact = source.IsContact;
            target.IsBot = source.IsBot;
            target.BotUserId = source.BotUserId != 0 ? source.BotUserId : target.BotUserId;
            target.ReplyMarkupMessageId = source.ReplyMarkupMessageId;
            target.BotDescription = source.BotDescription ?? target.BotDescription;
            target.BotMenuButtonType = source.BotMenuButtonType ?? target.BotMenuButtonType;
            target.BotMenuButtonText = source.BotMenuButtonText ?? target.BotMenuButtonText;
            target.BotMenuButtonUrl = source.BotMenuButtonUrl ?? target.BotMenuButtonUrl;
            if (source.BotCommands != null && source.BotCommands.Count > 0) target.BotCommands = source.BotCommands;
            target.IsGroup = source.IsGroup;
            target.IsBroadcast = source.IsBroadcast;
            target.IsChannel = source.IsChannel;
            target.IsJoined = source.IsJoined;
            target.CanJoin = source.CanJoin;
            target.IsForum = source.IsForum;
            target.IsForumTopic = source.IsForumTopic;
            target.TopicId = source.TopicId;
            target.TopicRootMessageId = source.TopicRootMessageId;
            target.TopicIconColor = source.TopicIconColor;
            target.TopicIconEmojiId = source.TopicIconEmojiId;
            target.TopicIconUri = source.TopicIconUri;
            target.IsTopicClosed = source.IsTopicClosed;
            target.ParentPeerType = source.ParentPeerType;
            target.ParentPeerId = source.ParentPeerId;
            target.ParentPeerKey = source.ParentPeerKey;
            target.ParentAccessHash = source.ParentAccessHash;
            target.ParentTitle = source.ParentTitle;
            target.CanSendMessages = source.CanSendMessages;
            target.CanPinMessages = source.CanPinMessages;
            target.CanDeleteMessages = source.CanDeleteMessages;
            target.NoForwards = source.NoForwards;
            if (source.SubscriberCount > 0) target.SubscriberCount = source.SubscriberCount;
            target.OnlineCount = source.OnlineCount;
            if (source.LastSeenUnixTime > 0) target.LastSeenUnixTime = source.LastSeenUnixTime;
            if (!string.IsNullOrEmpty(source.LastSeenText)) target.LastSeenText = source.LastSeenText;
            if (!string.IsNullOrEmpty(source.UserStatusKind)) target.UserStatusKind = source.UserStatusKind;
            if (!string.IsNullOrEmpty(source.Username)) target.Username = source.Username;
            if (!string.IsNullOrEmpty(source.Phone)) target.Phone = source.Phone;
            if (!string.IsNullOrEmpty(source.Bio)) target.Bio = source.Bio;
            if (!string.IsNullOrEmpty(source.BirthdayText)) target.BirthdayText = source.BirthdayText;
            target.ProfileChannel = source.ProfileChannel;
            target.IconText = source.IconText;
            target.TypeIcon = source.TypeIcon;
            target.TypeGlyph = source.TypeGlyph;
            target.AvatarUri = source.AvatarUri;
            target.AvatarIsPreview = source.AvatarIsPreview;
            target.AvatarPhotoId = source.AvatarPhotoId;
            target.AvatarDcId = source.AvatarDcId;
            target.AvatarStrippedThumb = source.AvatarStrippedThumb;
        }
    }

    public sealed class PhoneCodeSentInfo
    {
        public bool Authorized { get; set; }
        public string PhoneNumber { get; set; }
        public string PhoneCodeHash { get; set; }
        public string CodeType { get; set; }
        public int Length { get; set; }
        public int Timeout { get; set; }
        public string Message { get; set; }
    }

    public sealed class TelegramCloudPasswordRequiredException : InvalidOperationException
    {
        public TelegramCloudPasswordRequiredException(string message) : base(message) { }
    }

    public sealed class TelegramCallInfo
    {
        public long Id { get; set; }
        public long AccessHash { get; set; }
        public string State { get; set; }
        public bool IsAccepted { get; set; }
        public bool IsActive { get; set; }
        public bool IsDiscarded { get; set; }
        public string DiscardReason { get; set; }
        public int StartDate { get; set; }
        public bool IsIncomingRequested { get; set; }
        public long AdminId { get; set; }
        public long ParticipantId { get; set; }
        public int ProtocolIndex { get; set; }
        public string ProtocolName { get; set; }

        public byte[] LocalA { get; set; }
        public byte[] LocalGA { get; set; }
        public byte[] RemoteGB { get; set; }
        public byte[] RemoteGAHash { get; set; }
        public byte[] DhP { get; set; }
        public int DhG { get; set; }
        public byte[] AuthKey { get; set; }
        public long KeyFingerprint { get; set; }
        public long RemoteKeyFingerprint { get; set; }
        public bool IsConfirmed { get; set; }
    }

    public sealed class TelegramLinkTarget
    {
        public ChatViewModel Chat { get; set; }
        public int MessageId { get; set; }
    }
}
