        public async Task<ChatViewModel> RefreshFullChatInfoAsync(ChatViewModel chat, bool refreshDialogList)
        {
            if (chat == null) return null;
            if (chat.IsForumTopic) return chat;

            if (refreshDialogList)
            {
                try
                {
                    _client.ClearDialogsCache();
                    var dialogs = await _client.GetDialogsAsync(chat.FolderId);
                    var refreshed = FindSameChat(dialogs, chat);
                    if (refreshed != null)
                        CopyChatInfo(refreshed, chat);
                }
                catch
                {
                    // Keep the chat page usable if Telegram rejects or delays this request.
                }
            }

            try
            {
                var full = await _client.GetFullPeerInfoAsync(chat);
                if (full != null)
                    CopyChatInfo(full, chat);
            }
            catch
            {
                // Full info is optional: keep dialog data if Telegram refuses the request.
            }

            try
            {
                chat.IsMuted = await _client.GetNotificationsMutedAsync(chat);
            }
            catch
            {
                // Per-peer notification state is optional; keep the dialog value if this request fails.
            }

            return chat;
        }

