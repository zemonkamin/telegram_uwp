        }

        public async Task<PhoneCodeSentInfo> SendPhoneCodeAsync(string phoneNumber)
        {
            if (string.IsNullOrWhiteSpace(phoneNumber))
                throw new ArgumentException("Enter the phone number in international format.", "phoneNumber");

            _currentQr = null;
            var sent = await _client.SendPhoneCodeAsync(phoneNumber);
            if (sent == null)
                throw new InvalidOperationException("Telegram did not return auth.sentCode.");

            _lastPhoneNumber = phoneNumber;
            _lastPhoneCodeHash = sent.PhoneCodeHash;

            var message = sent.Authorized
                ? "Session is already authorized."
                : BuildPhoneCodeMessage(sent);

            return new PhoneCodeSentInfo
            {
                Authorized = sent.Authorized,
                PhoneNumber = phoneNumber,
                PhoneCodeHash = sent.PhoneCodeHash,
                CodeType = sent.CodeType,
                Length = sent.Length,
                Timeout = sent.Timeout,
                Message = message
            };
        }

        public async Task SignInWithPhoneCodeAsync(string code)
        {
            if (string.IsNullOrWhiteSpace(_lastPhoneNumber) || string.IsNullOrWhiteSpace(_lastPhoneCodeHash))
                throw new InvalidOperationException("Request a code for the phone number first.");
            if (string.IsNullOrWhiteSpace(code))
                throw new ArgumentException("Enter the Telegram code.", "code");

            await _client.SignInWithPhoneCodeAsync(_lastPhoneNumber, _lastPhoneCodeHash, code);
            await TelegramNotificationRegistrar.RegisterAsync();
        }

        public async Task SignInWithCloudPasswordAsync(string password)
        {
            if (string.IsNullOrWhiteSpace(password))
                throw new ArgumentException("Enter the cloud password.", "password");

            await _client.SignInWithCloudPasswordAsync(password);
            await TelegramNotificationRegistrar.RegisterAsync();
        }

        public async Task<QrLoginInfo> CreateQrLoginAsync()
        {
            var qr = await _client.CreateQrLoginAsync();
            if (qr == null)
                throw new InvalidOperationException("Telegram did not return a QR login token.");
            if (qr.LoginUrl == "authorized")
                return new QrLoginInfo { LoginUrl = "authorized", QrImageUrl = "", ExpiresUnix = 0 };
            _currentQr = qr;
            return _currentQr;
        }

        public async Task<QrLoginState> CheckQrLoginAsync()
        {
            if (_currentQr == null) return QrLoginState.TokenExpired;
            var now = (int)(DateTime.UtcNow - new DateTime(1970, 1, 1)).TotalSeconds;
            if (_currentQr.ExpiresUnix > 0 && now >= _currentQr.ExpiresUnix - 2)
                return QrLoginState.TokenExpired;

            // QR login works like in MadelineProto: the displayed token is not re-exported on every
            // timer tick. We read Telegram updates with a lightweight ping and call auth.exportLoginToken
            // only after updateLoginToken arrives.
            var token = await _client.CheckLoginTokenAsync();
            if (token.Success)
            {
                await TelegramNotificationRegistrar.RegisterAsync();
                return QrLoginState.Accepted;
            }
            if (token.Expired) return QrLoginState.TokenExpired;

            return QrLoginState.Waiting;
        }

