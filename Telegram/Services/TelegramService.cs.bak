        public event EventHandler<long> NewMessageArrived;
        public event EventHandler<long> MessageContentUpdated;
        public event EventHandler<long> MessagesDeleted;
        public event EventHandler<long> UserStatusChanged;

        private static readonly TelegramService _instance = new TelegramService();
        public static TelegramService Instance { get { return _instance; } }

        private readonly TdLibTelegramClient _client = new TdLibTelegramClient();
        private readonly SemaphoreSlim _tdLibOperationGate = new SemaphoreSlim(1, 1);
        private QrLoginInfo _currentQr;
        private string _lastPhoneNumber;
        private string _lastPhoneCodeHash;
        public QrLoginInfo CurrentQr { get { return _currentQr; } }

        private TelegramService() { }

        public void Start()
        {
            _client.NewMessageArrived += (s, chatId) =>
            {
                var h = NewMessageArrived;
                if (h != null) h(this, chatId);
            };
            _client.MessageContentUpdated += (s, chatId) =>
            {
                var h = MessageContentUpdated;
                if (h != null) h(this, chatId);
            };
            _client.MessagesDeleted += (s, chatId) =>
            {
                var h = MessagesDeleted;
                if (h != null) h(this, chatId);
            };
            _client.UserStatusChanged += (s, userId) =>
            {
                var h = UserStatusChanged;
                if (h != null) h(this, userId);
            };
            _client.Start();
        }

        public async Task<bool> IsAuthorizedAsync()
        {
            return await _client.IsAuthorizedAsync();
        }

        public void ApplyCachedUserStatus(long userId, ChatViewModel vm)
        {
            _client.ApplyCachedUserStatus(userId, vm);
        }

        public async Task ResetSessionAsync()
        {
            TelegramContinuousNotificationPoller.Stop();
            TelegramNotificationRegistrar.DisableLiveTile();
            _currentQr = null;
            _lastPhoneNumber = null;
            _lastPhoneCodeHash = null;
            await _client.ResetAsync();
        }

        public async Task ApplyConnectionSettingsAsync()
        {
            await _client.RefreshConnectionSettingsAsync();
        }

