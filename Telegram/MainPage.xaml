<Page
    x:Class="Telegram.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Telegram"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!--  YOUR PHONE  -->
        <Grid x:Name="PhonePanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="19,0,12,14"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Style="{StaticResource HeaderTextBlockStyle}"
                        Text="Your phone" />
                    <Button
                        x:Name="ProxyOpenButton"
                        Grid.Column="1"
                        Margin="8,2,0,0"
                        Padding="8,4,8,4"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ProxyOpenButton_Click"
                        Content="proxy"
                        FontSize="14"
                        FontWeight="SemiLight" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="19,0,19,0">
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="15"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Please confirm your country code and enter your phone number."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Country" />

                    <Button
                        x:Name="CountrySelectButton"
                        Height="40"
                        Margin="0,0,0,14"
                        Padding="10,0,10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource AppBarBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource AppBarToggleButtonCheckGlyphForegroundCheckedDisabled}"
                        Click="CountrySelectButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CountrySelectText"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="France"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Phone number" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="PhoneCodeBox"
                            Grid.Column="0"
                            FontSize="18"
                            InputScope="TelephoneNumber"
                            PlaceholderText="+33"
                            TextAlignment="Center" />

                        <TextBox
                            x:Name="PhoneNumberBox"
                            Grid.Column="2"
                            FontSize="18"
                            InputScope="TelephoneNumber"
                            KeyDown="PhoneNumberBox_KeyDown"
                            PlaceholderText="123456789" />
                    </Grid>

                    <StackPanel
                        x:Name="CodePanel"
                        Margin="0,14,0,0"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="Code" />
                        <TextBox
                            x:Name="CodeBox"
                            FontSize="18"
                            InputScope="Number"
                            KeyDown="CodeBox_KeyDown"
                            PlaceholderText="12345" />
                        <Button
                            x:Name="SignInButton"
                            Height="44"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            Click="SignInButton_Click"
                            Content="Sign in"
                            Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,14,0,0"
                        FontSize="13"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Padding="15"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="SendCodeButton"
                    Height="40"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="0"
                    Click="SendCodeButton_Click"
                    Content="Continue"
                    FontSize="16"
                    Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}" />
                <Button
                    x:Name="ShowQrButton"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    BorderThickness="0"
                    Click="ShowQrButton_Click"
                    Content="Use QR code"
                    FontSize="16" />
            </StackPanel>
        </Grid>

        <!--  LOGIN WITH QR CODE  -->
        <Grid x:Name="QrPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="19,0,12,14"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="28"
                    Style="{StaticResource HeaderTextBlockStyle}"
                    Text="Login with QR code" />
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="19,0,19,0">
                    <Grid
                        x:Name="QrContainer"
                        Width="280"
                        Height="280"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                        <Border Background="Black">
                            <Canvas
                                x:Name="QrCodeCanvas"
                                Width="280"
                                Height="280"
                                Background="Black"
                                UseLayoutRounding="True" />
                        </Border>
                        <Grid
                            x:Name="QrLoadingOverlay"
                            Background="Black"
                            Visibility="Visible">
                            <ProgressRing
                                x:Name="QrProgressRing"
                                Width="48"
                                Height="48"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                IsActive="True" />
                        </Grid>
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,18"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Scan from mobile Telegram"
                        TextAlignment="Center" />

                    <Grid Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                Text="1" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="Open Telegram on your phone"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                Text="2" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="Go to Settings &gt; Devices &gt; Scan QR code"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                Text="3" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="Scan the code above to login"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        x:Name="QrStatusText"
                        Margin="0,0,0,12"
                        FontSize="13"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Padding="15"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="UsePhoneButton"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    BorderThickness="0"
                    Click="UsePhoneButton_Click"
                    Content="Use phone number"
                    FontSize="16" />
            </StackPanel>
        </Grid>

        <!--  CLOUD PASSWORD  -->
        <Grid x:Name="PasswordPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="19,0,12,14"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="28"
                    Style="{StaticResource HeaderTextBlockStyle}"
                    Text="Cloud password" />
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="19,0,19,0">
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="15"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="You have two-step verification enabled, so your account is protected with an additional password."
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="CloudPasswordBox"
                        FontSize="18"
                        KeyDown="CloudPasswordBox_KeyDown"
                        PlaceholderText="password" />
                    <TextBlock
                        x:Name="PasswordStatusText"
                        Margin="0,14,0,0"
                        FontSize="13"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Padding="15"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="CloudPasswordButton"
                    Height="40"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="0"
                    Click="CloudPasswordButton_Click"
                    Content="Confirm"
                    FontSize="16"
                    Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}" />
                <Button
                    x:Name="ForgotPasswordButton"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    BorderThickness="0"
                    Click="ForgotPasswordButton_Click"
                    Content="Forgot password"
                    FontSize="16" />
            </StackPanel>
        </Grid>

        <!--  PROXY SETTINGS  -->
        <Grid x:Name="ProxyPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="19,0,12,14"
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="28"
                    Style="{StaticResource HeaderTextBlockStyle}"
                    Text="Proxy settings" />
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="19,0,19,0">
                    <Grid Margin="0,8,0,4" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="Use proxy" />
                        <ToggleSwitch
                            x:Name="ProxyEnabledToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="ProxyEnabledToggle_Toggled" />
                    </Grid>

                    <StackPanel x:Name="ProxyListSection" Visibility="Collapsed">
                        <ListView
                            x:Name="ProxyListView"
                            Margin="0,8,0,0"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            IsItemClickEnabled="True"
                            ItemClick="ProxyListView_ItemClick"
                            ReorderMode="Enabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,4" Holding="ProxyItem_Holding" RightTapped="ProxyItem_RightTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding Initial}" />
                                            <Grid Background="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                                    Glyph="&#xE73E;" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Text="{Binding Subtitle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button
                            x:Name="ProxyAddButton"
                            Margin="0,4,0,0"
                            Padding="0,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ProxyAddButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                        Glyph="&#xE710;" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock FontSize="16" Text="Add proxy" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="MTProto, SOCKS5 or HTTP" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="13"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="Proxy servers can help you connect to Telegram when it is blocked. Tap a proxy to connect, hold to edit or delete, and drag to reorder."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ProxyStatusText"
                        Margin="0,14,0,0"
                        FontSize="13"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
